<Window x:Class="Vermilune.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:Vermilune.UI.Pages"
        Title="Vermilune" Width="1280" Height="800" MinWidth="1100" MinHeight="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style x:Key="InvisibleThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid">
        <!-- 不透明底色在上，背景图叠在底色之上；100% 时不会透出桌面。 -->
        <Border x:Name="BgTint" CornerRadius="10" Background="{DynamicResource WindowBgBrush}" />
        <Border x:Name="BgImageBorder" CornerRadius="10" Visibility="Collapsed">
            <Border.Background>
                <ImageBrush x:Name="BgImageBrush" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
            </Border.Background>
        </Border>

        <!-- 主框 -->
        <Border x:Name="Frame" CornerRadius="10" BorderBrush="Transparent"
                BorderThickness="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/VermiluneRing.png"
                               Width="26" Height="26" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="VERMILUNE" FontFamily="{DynamicResource DisplayFont}" FontSize="11.5"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="TitleStatus" Grid.Column="1" Text="正在初始化…" FontSize="10.5"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="460" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Button x:Name="OpacityButton" Style="{StaticResource IconButton}" Click="OpacityButton_Click"
                                ToolTip="界面透明度">
                            <Path Data="{DynamicResource IconDroplet}" Width="15" Height="17" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" Fill="Transparent" />
                        </Button>
                        <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" Click="Minimize_Click"
                                ToolTip="最小化">
                            <Path Data="{DynamicResource IconMinimize}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" Fill="Transparent" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource IconButton}" Click="Maximize_Click"
                                ToolTip="最大化">
                            <Path x:Name="MaximizeIcon" Data="{DynamicResource IconMaximize}" Width="12" Height="12"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" Fill="Transparent" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Click="Close_Click"
                                ToolTip="关闭">
                            <Path Data="{DynamicResource IconClose}" Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" Fill="Transparent" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧导航 -->
                    <Border Grid.Column="0" BorderThickness="0"
                            Background="{DynamicResource WindowBgBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="11,10,11,0" VerticalAlignment="Top">
                                <RadioButton x:Name="NavLaunch" Style="{StaticResource NavItem}" GroupName="Nav"
                                             Tag="launch" IsChecked="True" Checked="Nav_Checked" ToolTip="启动">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="{DynamicResource IconPlay}" Width="18" Height="18" Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              HorizontalAlignment="Center" />
                                        <TextBlock Text="启动" FontSize="9.5" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavDownload" Style="{StaticResource NavItem}" GroupName="Nav"
                                             Tag="download" Checked="Nav_Checked" ToolTip="下载">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="{DynamicResource IconDownload}" Width="18" Height="18" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.6" Fill="Transparent" HorizontalAlignment="Center" />
                                        <TextBlock Text="下载" FontSize="9.5" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavVersions" Style="{StaticResource NavItem}" GroupName="Nav"
                                             Tag="versions" Checked="Nav_Checked" ToolTip="版本">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="{DynamicResource IconCube}" Width="18" Height="18" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" />
                                        <TextBlock Text="版本" FontSize="9.5" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav"
                                             Tag="settings" Checked="Nav_Checked" ToolTip="设置">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="{DynamicResource IconTune}" Width="18" Height="18" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.6" Fill="Transparent" HorizontalAlignment="Center" />
                                        <TextBlock Text="设置" FontSize="9.5" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavError" Style="{StaticResource NavItem}" GroupName="Nav"
                                             Tag="error" Checked="Nav_Checked" ToolTip="报错分析">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="{DynamicResource IconWarning}" Width="18" Height="18" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="1.5" Fill="Transparent" HorizontalAlignment="Center" />
                                        <TextBlock Text="报错" FontSize="9.5" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="NavMore" Style="{StaticResource NavItem}" GroupName="Nav"
                                             Tag="more" Checked="Nav_Checked" ToolTip="更多">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Grid Width="18" Height="18">
                                            <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="更多" FontSize="9.5" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,0,0,14" HorizontalAlignment="Center">
                                <TextBlock x:Name="RailVersion" Text="v1.2.11-beta" FontSize="9"
                                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 页面 -->
                    <ContentControl x:Name="PageHost" Grid.Column="1" Margin="0,8,0,0" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

                </Grid>
            </Grid>
        </Border>

        <!-- 浮层提示 -->
        <Border x:Name="ToastBar" Visibility="Collapsed" Opacity="0" VerticalAlignment="Bottom"
                HorizontalAlignment="Center" Margin="0,0,0,26" Padding="16,10" CornerRadius="10"
                Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource StrokeStrongBrush}"
                BorderThickness="1" Panel.ZIndex="50">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="ToastText" Margin="9,0,0,0" FontSize="11.5" />
            </StackPanel>
        </Border>

        <!-- 透明度浮层 -->
        <Popup x:Name="OpacityPopup" PlacementTarget="{Binding ElementName=OpacityButton}" Placement="Bottom"
               VerticalOffset="8" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Focusable="False">
            <Border Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource StrokeStrongBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16" Width="268">
                <StackPanel>
                    <TextBlock Text="界面透明度" Style="{StaticResource CardTitle}" />
                    <Grid Margin="0,8,0,0">
                        <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" Value="88"
                                ValueChanged="OpacitySlider_ValueChanged" />
                        <TextBlock x:Name="OpacityValue" Text="88%" FontSize="10.5" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}"
                                   Margin="0,0,2,0" IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock Text="背景图不透明度" Style="{StaticResource Label}" Margin="0,14,0,0" />
                    <Slider x:Name="BgOpacitySlider" Minimum="0" Maximum="100" Value="34" Margin="0,6,0,0"
                            ValueChanged="BgOpacitySlider_ValueChanged" />
                    <TextBlock Text="透明度只影响背景与面板，文字始终保持清晰。"
                               Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- 拖入整合包安装进度 -->
        <Border x:Name="DropOverlay" Visibility="Collapsed" Background="#99000000" CornerRadius="10"
                Panel.ZIndex="75">
            <Border Width="430" Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource StrokeStrongBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="22"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="正在安装整合包" FontFamily="{DynamicResource DisplayFont}" FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="DropStatusText" Text="准备中…" Style="{StaticResource MutedText}"
                               Margin="0,8,0,0" TextWrapping="Wrap" />
                    <ProgressBar x:Name="DropProgress" Height="5" IsIndeterminate="True" Margin="0,14,0,0" />
                    <Button x:Name="DropCancelButton" Content="取消" Style="{StaticResource ButtonBase}"
                            HorizontalAlignment="Right" Margin="0,16,0,0" Click="DropCancel_Click" />
                </StackPanel>
            </Border>
        </Border>

        <!-- 无边框缩放 -->
        <Thumb x:Name="ThumbLeft" Width="6" HorizontalAlignment="Left" VerticalAlignment="Stretch"
               Style="{StaticResource InvisibleThumb}" Cursor="SizeWE" Tag="L" DragDelta="Resize_DragDelta" Panel.ZIndex="80" />
        <Thumb x:Name="ThumbRight" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
               Style="{StaticResource InvisibleThumb}" Cursor="SizeWE" Tag="R" DragDelta="Resize_DragDelta" Panel.ZIndex="80" />
        <Thumb x:Name="ThumbTop" Height="6" VerticalAlignment="Top" HorizontalAlignment="Stretch"
               Style="{StaticResource InvisibleThumb}" Cursor="SizeNS" Tag="T" DragDelta="Resize_DragDelta" Panel.ZIndex="80" />
        <Thumb x:Name="ThumbBottom" Height="6" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
               Style="{StaticResource InvisibleThumb}" Cursor="SizeNS" Tag="B" DragDelta="Resize_DragDelta" Panel.ZIndex="80" />
        <Thumb x:Name="ThumbTL" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
               Style="{StaticResource InvisibleThumb}" Cursor="SizeNWSE" Tag="TL" DragDelta="Resize_DragDelta" Panel.ZIndex="81" />
        <Thumb x:Name="ThumbTR" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
               Style="{StaticResource InvisibleThumb}" Cursor="SizeNESW" Tag="TR" DragDelta="Resize_DragDelta" Panel.ZIndex="81" />
        <Thumb x:Name="ThumbBL" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Style="{StaticResource InvisibleThumb}" Cursor="SizeNESW" Tag="BL" DragDelta="Resize_DragDelta" Panel.ZIndex="81" />
        <Thumb x:Name="ThumbBR" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Style="{StaticResource InvisibleThumb}" Cursor="SizeNWSE" Tag="BR" DragDelta="Resize_DragDelta" Panel.ZIndex="81" />
    </Grid>
</Window>
