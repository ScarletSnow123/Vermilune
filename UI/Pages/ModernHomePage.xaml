<UserControl x:Class="Vermilune.UI.Pages.ModernHomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Vermilune.UI.Converters"
             xmlns:controls="clr-namespace:Vermilune.UI.Controls"
             FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <converters:PathImageConverter x:Key="PathImage" />
        <Style x:Key="SoftLink" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource HomeTextSubBrush}" />
        </Style>
        <Style x:Key="Kicker" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource HomeTextSubBrush}" />
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid Width="1210" Height="720" Margin="34,14,34,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部快捷入口 -->
        <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SoftLink}" Content="下载游戏" Click="OpenDownload_Click" Margin="0,0,16,0" />
                <Button Style="{StaticResource SoftLink}" Content="版本管理" Click="ManageVersion_Click" Margin="0,0,16,0" />
                <Button Style="{StaticResource SoftLink}" Content="实例资源" Click="OpenInstanceResources_Click" Margin="0,0,16,0" />
                <Button Style="{StaticResource SoftLink}" Content="设置" Click="OpenSettings_Click" Margin="0,0,16,0" />
                <Button Style="{StaticResource SoftLink}" Content="日志" Click="OpenLog_Click" />
            </StackPanel>
        </Grid>

        <!-- 中部留白，让背景成为主视觉 -->
        <Border Grid.Row="1" />

        <!-- 底部左侧：当前实例 -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" MaxWidth="600">
            <TextBlock Text="这个启动器纯娱乐的，轻点骂qwq" Style="{StaticResource Kicker}" />
            <TextBlock x:Name="InstanceTitle" Text="{Binding InstanceName}" FontFamily="{DynamicResource DisplayFont}"
                       Foreground="{DynamicResource HomeTextBrush}"
                       FontSize="68" FontWeight="Bold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
            <Grid HorizontalAlignment="Left" Margin="0,12,0,0">
                <Button x:Name="VersionButton" Width="560" Height="72" Click="VersionButton_Click" Foreground="{DynamicResource TextBrush}"
                        Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1" Padding="10,0" HorizontalContentAlignment="Stretch" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="10" Background="{DynamicResource Surface2Brush}"
                                ClipToBounds="True" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="{Binding SelectedVersion.Initial}" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding SelectedVersion.IconPath, Converter={StaticResource PathImage}}"
                                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedVersion.DisplayName, FallbackValue=选择版本}"
                                       FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedVersion.SubLine}" FontSize="13.5"
                                       Foreground="{DynamicResource TextSubBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedVersion.LoaderBadge}" FontSize="13.5"
                                       Foreground="{DynamicResource AccentBrush}" Margin="10,0,10,0" />
                            <Path Data="M0,0 L5,5 L10,0 Z" Width="9" Height="5" Stretch="Fill"
                                  Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Popup x:Name="VersionPopup" PlacementTarget="{Binding ElementName=VersionButton}" Placement="Bottom"
                       StaysOpen="True" AllowsTransparency="True" VerticalOffset="6" PopupAnimation="None" Closed="VersionPopup_Closed">
                    <Border Width="560" MaxHeight="430" TextElement.Foreground="{DynamicResource TextBrush}"
                            Background="{DynamicResource Surface3Brush}"
                            BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Versions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" Click="VersionItem_Click" Height="72"
                                                HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                Foreground="{DynamicResource TextBrush}"
                                                Background="Transparent" BorderThickness="0" Padding="10,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="7"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Row" Property="Opacity" Value="0.9" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="50" Height="50" CornerRadius="11"
                                                        Background="{DynamicResource Surface2Brush}" ClipToBounds="True"
                                                        Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{Binding IconPath, Converter={StaticResource PathImage}}"
                                                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SubLine}" FontSize="13.5"
                                                               Foreground="{DynamicResource TextSubBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding LoaderBadge}" FontSize="13.5"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <TextBlock x:Name="VersionMetaText" Text="{Binding VersionMeta}" FontSize="11.5" Margin="0,9,0,0"
                       Foreground="{DynamicResource HomeTextSubBrush}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource SoftLink}" Content="修改实例" Click="EditVersion_Click" Margin="0,0,14,0" />
                <Button Style="{StaticResource SoftLink}" Content="打开目录" Click="OpenVersionFolder_Click" Margin="0,0,14,0" />
                <Button Style="{StaticResource SoftLink}" Content="资源" Click="OpenInstanceResources_Click" />
            </StackPanel>
        </StackPanel>

        <!-- 底部右侧：账号与启动 -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="310">
            <controls:SkinPreview3D x:Name="SkinPreview" Width="220" Height="300" ShowHint="False"
                                    HorizontalAlignment="Right" Margin="0,0,-64,26" />
            <Grid HorizontalAlignment="Right" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <TextBlock x:Name="AccountNameText" Text="{Binding AccountName}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource HomeTextBrush}"
                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AccountSubText" Text="{Binding AccountSub}" FontSize="12"
                               Foreground="{DynamicResource HomeTextMutedBrush}" HorizontalAlignment="Right" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
                        <Button Style="{StaticResource SoftLink}" Content="切换皮肤" FontSize="11.5" Click="SwitchSkin_Click" />
                        <TextBlock Text="/" Foreground="{DynamicResource HomeTextMutedBrush}" FontSize="10.5" Margin="6,0" />
                        <Button Style="{StaticResource SoftLink}" Content="切换披风" FontSize="11.5" Click="SwitchCape_Click" />
                    </StackPanel>
                    <Button Content="切换账号" Style="{StaticResource SoftButton}" Height="28" Padding="12,0"
                            HorizontalAlignment="Right" Margin="0,7,0,0" Click="Account_Click" />
                </StackPanel>
                <Border Grid.Column="1" Width="104" Height="104" CornerRadius="22" ClipToBounds="True"
                        Background="{DynamicResource AccentSoftBrush}">
                    <Grid>
                        <TextBlock x:Name="AvatarInitialText" Text="{Binding AvatarInitial}" FontSize="38" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Image x:Name="AvatarImage" Stretch="Fill" RenderOptions.EdgeMode="Aliased"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Grid>
                </Border>
            </Grid>

            <Button x:Name="LaunchButton" Height="72" Style="{StaticResource PrimaryButton}" Click="Launch_Click"
                    Padding="18,0" HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="LaunchIcon" Width="20" Height="22" Stretch="Uniform" Data="{DynamicResource IconPlay}"
                          Fill="#FF08110D" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="LaunchTitleText" Text="{Binding LaunchTitle}" FontSize="19" FontWeight="Bold"
                                   Foreground="#FF08110D" />
                        <TextBlock x:Name="LaunchSubText" Text="{Binding LaunchSub}" FontSize="10.5"
                                   Foreground="#9908110D" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" x:Name="LaunchHint" Text="ENTER" FontSize="9"
                               Foreground="#8008110D" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Border x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,8,0,0"
                    Background="#AA0F0A14" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="11" Padding="11,8">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="ProgressText" Text="准备启动…" FontSize="9.5"
                                   Foreground="{DynamicResource TextSubBrush}" TextTrimming="CharacterEllipsis" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource LinkButton}" Content="取消"
                                FontSize="9" Click="CancelLaunch_Click" />
                    </Grid>
                    <ProgressBar x:Name="LaunchProgress" Height="3" Margin="0,6,0,0" Minimum="0" Maximum="100"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource TrackBrush}"
                                 BorderThickness="0" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Text="" FontSize="10.5"
                       Foreground="{DynamicResource HomeTextMutedBrush}" HorizontalAlignment="Right" Margin="0,8,0,0"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="DateText" Text="" FontSize="10" Foreground="{DynamicResource HomeTextMutedBrush}"
                       HorizontalAlignment="Right" Margin="0,3,0,0" />
        </StackPanel>

        <Border x:Name="VersionDismissLayer" Grid.RowSpan="3" Panel.ZIndex="100"
                Background="#01000000" Visibility="Collapsed"
                MouseLeftButtonDown="VersionDismissLayer_Click" />
    </Grid>
    </Viewbox>
</UserControl>
