<UserControl x:Class="Vermilune.UI.Pages.SyncPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="24,0,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,12,0,0">
            <TextBlock Text="同步" Style="{StaticResource PageTitle}" />
            <TextBlock Text="把一个实例的按键、地图缓存和自定义数据同步到其他版本"
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,30">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="自动同步" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="启动游戏前同步" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="每次启动目标实例前，把下面勾选的数据从源实例复制过去"
                                           Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox x:Name="AutoSyncCheck" Grid.Column="1" VerticalAlignment="Center"
                                      Checked="AutoSync_Changed" Unchecked="AutoSync_Changed" />
                        </Grid>
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="源实例" Style="{StaticResource FormLabel}" />
                            <ComboBox x:Name="SyncSourceCombo" Height="34" DisplayMemberPath="DisplayName"
                                      SelectionChanged="SyncSource_Changed" />
                            <TextBlock Text="自动同步以这个实例的数据为准" Style="{StaticResource MutedText}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="同步内容" Style="{StaticResource SectionTitle}" />
                        <WrapPanel Margin="0,10,0,0">
                            <CheckBox x:Name="SyncKeysCheck" Content="按键设置" Margin="0,0,18,0"
                                      Checked="SyncItem_Changed" Unchecked="SyncItem_Changed" />
                            <CheckBox x:Name="SyncGameCheck" Content="游戏 / 画面设置" Margin="0,0,18,0"
                                      Checked="SyncItem_Changed" Unchecked="SyncItem_Changed" />
                            <CheckBox x:Name="SyncLangCheck" Content="语言" Margin="0,0,18,0"
                                      Checked="SyncItem_Changed" Unchecked="SyncItem_Changed" />
                            <CheckBox x:Name="SyncPacksCheck" Content="资源包" Margin="0,0,18,0"
                                      Checked="SyncItem_Changed" Unchecked="SyncItem_Changed" />
                        </WrapPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <CheckBox x:Name="SyncXaeroCheck" Content="Xaero 小地图 / 世界地图缓存" Margin="0,0,18,0"
                                      Checked="SyncItem_Changed" Unchecked="SyncItem_Changed" />
                            <CheckBox x:Name="SyncJourneyCheck" Content="JourneyMap 缓存" Margin="0,0,18,0"
                                      Checked="SyncItem_Changed" Unchecked="SyncItem_Changed" />
                            <CheckBox x:Name="SyncShadersCheck" Content="光影包"
                                      Checked="SyncItem_Changed" Unchecked="SyncItem_Changed" />
                        </WrapPanel>
                        <TextBlock Text="地图缓存可能很大，第一次同步会慢一些&#10;只按文件覆盖，不保证所有地图 Mod 版本格式完全兼容"
                                   Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="自定义路径" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="相对游戏目录的文件夹或文件，比如 XaeroWaypoints、config/xxx"
                                   Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SyncPathBox" Style="{StaticResource InputBox}" Height="32"
                                     Tag="例如 config/xxx" />
                            <Button Grid.Column="2" Style="{StaticResource ButtonBase}" Height="32"
                                    Content="添加" Click="AddPath_Click" />
                        </Grid>
                        <ListBox x:Name="SyncPathsList" Height="92" Margin="0,8,0,0"
                                 Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}"
                                 BorderThickness="1" PreviewMouseWheel="SyncPathsList_PreviewMouseWheel" />
                        <Button Style="{StaticResource GhostButton}" Height="30" Content="移除选中"
                                HorizontalAlignment="Left" Margin="0,7,0,0" Click="RemovePath_Click" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="立即同步" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="目标实例" Style="{StaticResource FormLabel}" VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <ComboBox x:Name="SyncTargetCombo" Width="240" Height="32" DisplayMemberPath="DisplayName" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Height="32" Content="同步到目标"
                                    Click="SyncOne_Click" />
                            <Button Style="{StaticResource ButtonBase}" Height="32" Content="同步到所有其他版本"
                                    Margin="8,0,0,0" Click="SyncAll_Click" />
                            <TextBlock x:Name="SyncStatusText" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
