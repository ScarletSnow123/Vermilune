<UserControl x:Class="Vermilune.UI.Pages.MorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource UiFont}"
             Foreground="{DynamicResource TextBrush}">
    <Grid Margin="24,0,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="更多" Style="{StaticResource PageTitle}" />
            <TextBlock Text="关于、参考与诊断。这里集中放版本信息和常用工具。" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,30">
                <Border Style="{StaticResource Card}" Padding="22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="64" Height="64" CornerRadius="18" ClipToBounds="True" Background="Transparent">
                            <Image Source="pack://application:,,,/Assets/VermiluneIcon.png" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Vermilune" FontFamily="{DynamicResource DisplayFont}" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="Minecraft 启动器 · .NET 10 / WPF" FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
                            <TextBlock Text="版本 1.2.13-beta" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Height="34" Content="打开数据目录" Click="OpenData_Click" />
                            <Button Style="{StaticResource GhostButton}" Height="30" Content="打开启动器日志" Margin="0,6,0,0"
                                    Click="OpenLogs_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="使用提示" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="启动、下载、版本管理与 Mod 分析都在本地完成。"
                                       Style="{StaticResource MutedText}" Margin="0,9,0,0" />
                            <TextBlock Text="配置与日志保存在启动器目录，不会改动游戏存档或 Mods。"
                                       Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="快捷入口" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="常用目录与诊断工具。" Style="{StaticResource MutedText}" Margin="0,9,0,0" />
                            <StackPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource ButtonBase}" Height="32" Content="打开数据目录"
                                        HorizontalAlignment="Left" Click="OpenData_Click" />
                                <Button Style="{StaticResource ButtonBase}" Height="32" Content="打开启动器日志"
                                        HorizontalAlignment="Left" Margin="0,7,0,0" Click="OpenLogs_Click" />
                                <Button Style="{StaticResource ButtonBase}" Height="32" Content="报错分析"
                                        HorizontalAlignment="Left" Margin="0,7,0,0" Click="GoError_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="键盘与快捷方式" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Enter" Style="{StaticResource Label}" />
                                <TextBlock Grid.Column="1" Text="在启动页启动当前版本" FontSize="11.5" />
                                <TextBlock Grid.Row="1" Text="F5" Style="{StaticResource Label}" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="在版本页重新扫描版本" FontSize="11.5" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="2" Text="Esc" Style="{StaticResource Label}" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="关闭透明度浮层" FontSize="11.5" Margin="0,8,0,0" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <TextBlock Text="便携模式" Style="{StaticResource Label}" />
                            <TextBlock Text="双击 exe 即启动；配置、日志、实例设置都在 exe 旁的 Vermilune 文件夹。"
                                       Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="运行环境" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="EnvText" Text="—" Style="{StaticResource MutedText}" Margin="0,9,0,0" />
                            <Border Style="{StaticResource Divider}" />
                            <TextBlock Text="诊断" Style="{StaticResource Label}" />
                            <TextBlock Text="遇到问题时，启动日志与「报错」页的分析结果足以定位多数启动失败。"
                                       Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource ButtonBase}" Height="30" Content="复制环境信息" Click="CopyEnv_Click" Margin="0,0,8,0" />
                                <Button Style="{StaticResource ButtonBase}" Height="30" Content="报错分析" Click="GoError_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="版权与免责" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Vermilune 是个人项目；Minecraft 客户端、资源与各 Mod 的版权归 Mojang Studios 与对应作者所有。"
                                   Style="{StaticResource MutedText}" Margin="0,9,0,0" />
                        <TextBlock Text="本启动器不绕过正版验证，不提供盗版资源；请使用自己拥有的账号与合法获取的整合包。"
                                   Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                        <TextBlock Text="主页右栏沿用原有布局与配色；古明地觉图片仅作个人启动器装饰。"
                                   Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                        <TextBlock Text="第三方组件：.NET 10、WPF。"
                                   Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
