<UserControl x:Class="Vermilune.UI.Pages.MorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource UiFont}"
             Foreground="{DynamicResource TextBrush}">
    <Grid Margin="24,0,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="更多" Style="{StaticResource PageTitle}" />

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,30">
                <Border Style="{StaticResource Card}" Padding="22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="64" Height="64" CornerRadius="16" ClipToBounds="True" Background="Transparent">
                            <Image Source="pack://application:,,,/Assets/VermiluneIcon.png" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Vermilune" FontFamily="{DynamicResource DisplayFont}" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="Minecraft 启动器 · .NET 10 / WPF" FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
                            <TextBlock Text="版本 1.3.10" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Height="34" Content="打开数据目录" Click="OpenData_Click" />
                            <Button Style="{StaticResource GhostButton}" Height="30" Content="打开启动器日志" Margin="0,6,0,0"
                                    Click="OpenLogs_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="工具" Style="{StaticResource SectionTitle}" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource ButtonBase}" Height="32" Content="数据目录"
                                    Margin="0,0,8,8" Click="OpenData_Click" />
                            <Button Style="{StaticResource ButtonBase}" Height="32" Content="启动器日志"
                                    Margin="0,0,8,8" Click="OpenLogs_Click" />
                            <Button Style="{StaticResource ButtonBase}" Height="32" Content="报错分析"
                                    Margin="0,0,8,8" Click="GoError_Click" />
                            <Button Style="{StaticResource ButtonBase}" Height="32" Content="导出诊断包"
                                    Margin="0,0,8,8" Click="ExportDiagnostics_Click" />
                            <Button Style="{StaticResource ButtonBase}" Height="32" Content="检查更新"
                                    Margin="0,0,8,8" Click="CheckUpdates_Click" />
                            <Button Style="{StaticResource ButtonBase}" Height="32" Content="复制环境信息"
                                    Margin="0,0,8,8" Click="CopyEnv_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="运行环境" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="EnvText" Text="—" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                   Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
