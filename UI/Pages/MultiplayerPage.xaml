<UserControl x:Class="Vermilune.UI.Pages.MultiplayerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="24,0,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,12,0,0">
            <TextBlock Text="联机" Style="{StaticResource PageTitle}" />
            <TextBlock Text="通过虚拟局域网连接 Minecraft。房主开放局域网，朋友填写同一房间码即可。"
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,30">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="房间设置" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="房主和朋友需要填写相同的房间码和密码；虚拟 IP 不能重复。"
                                   Style="{StaticResource MutedText}" Margin="0,6,0,0" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="房间码" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="RoomBox" Style="{StaticResource InputBox}" Height="34"
                                         Tag="例如 vermilune-room" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="房间密码" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="SecretBox" Style="{StaticResource InputBox}" Height="34"
                                         Tag="至少 6 位" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="我的虚拟 IP" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="IpBox" Style="{StaticResource InputBox}" Height="34"
                                         Tag="房主 10.126.126.1，朋友 .2" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="公共节点" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="NodeBox" Style="{StaticResource InputBox}" Height="34"
                                         Tag="tcp://easytier-us.slarker.me:11010" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Height="36"
                                    Padding="18,0" Content="开始联机" Click="Start_Click" />
                            <Button x:Name="StopButton" Style="{StaticResource ButtonBase}" Height="36"
                                    Padding="16,0" Content="停止" Margin="8,0,0,0"
                                    IsEnabled="False" Click="Stop_Click" />
                            <TextBlock x:Name="StatusText" Text="未启动。" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="连接地址" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="AddressText" Text="启动联机后显示虚拟 IP。"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="16"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource ButtonBase}" Height="32" Content="复制地址"
                                    Click="Copy_Click" />
                            <Button Style="{StaticResource ButtonBase}" Height="32" Content="检测 LAN 端口"
                                    Margin="8,0,0,0" Click="Detect_Click" />
                        </StackPanel>
                        <TextBlock x:Name="LanHint" Text="在游戏里选择「对局域网开放」，启动器会自动读取端口。"
                                   Style="{StaticResource MutedText}" Margin="0,9,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="使用步骤" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="1. 房主和朋友的虚拟 IP 分别设置为 .1、.2。" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                        <TextBlock Text="2. 双方填写相同房间码和密码，点击「开始联机」。" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                        <TextBlock Text="3. 房主进入游戏，对局域网开放。" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                        <TextBlock Text="4. 朋友在多人游戏里直接连接上方显示的地址。" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                        <TextBlock Text="首次使用会从 GitHub 下载 EasyTier；它需要 TUN 驱动，必要时请以管理员身份运行启动器。"
                                   Style="{StaticResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
