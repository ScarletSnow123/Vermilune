<UserControl x:Class="Vermilune.UI.Pages.MultiplayerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="24,0,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,12,0,0">
            <TextBlock Text="联机" Style="{StaticResource PageTitle}" />
            <TextBlock Text="在主机上一键开启小服务器，朋友通过公网地址直接加入。"
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,30">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="一键开服" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="服务端在后台运行，不需要一直打开游戏。原版与 Fabric 实例支持一键准备服务端文件。"
                                   Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="实例" Style="{StaticResource FormLabel}" />
                                <ComboBox x:Name="ServerVersionCombo" Height="34" DisplayMemberPath="DisplayName" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="内存 MB" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="ServerMemoryBox" Style="{StaticResource InputBox}" Height="34" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="端口" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="ServerPortBox" Style="{StaticResource InputBox}" Height="34" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="ServerEulaCheck" Content="我已阅读并同意 Minecraft 最终用户许可协议（EULA）"
                                  FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="ServerStartButton" Style="{StaticResource PrimaryButton}" Height="36"
                                    Padding="18,0" Content="一键开服" Click="StartServer_Click" />
                            <Button x:Name="ServerStopButton" Style="{StaticResource ButtonBase}" Height="36"
                                    Padding="16,0" Content="关闭服务器" Margin="8,0,0,0"
                                    IsEnabled="False" Click="StopServer_Click" />
                            <TextBlock x:Name="ServerStatusText" Text="未启动。" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>

                        <Border Background="{DynamicResource HomeLogInnerBrush}" CornerRadius="4"
                                Margin="0,10,0,0" Padding="7,5">
                            <ScrollViewer Height="96" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="ServerLogText" Text="等待服务端输出…"
                                           FontFamily="{DynamicResource MonoFont}" FontSize="9"
                                           Foreground="{DynamicResource HomeLogTextBrush}"
                                           TextWrapping="NoWrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="连接地址" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="AddressText" Text="开服后显示公网或本地地址。"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="16"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0" />
                        <TextBlock x:Name="MappingText" Text="正在等待开服。" Style="{StaticResource MutedText}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                        <Button Style="{StaticResource ButtonBase}" Height="32" Content="复制地址"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Click="Copy_Click" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="使用说明" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="1. 选择原版或 Fabric 实例，设置内存和端口。" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                        <TextBlock Text="2. 勾选 EULA，点击「一键开服」。" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                        <TextBlock Text="3. 把上方地址发给朋友，在多人游戏中直接连接。" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                        <TextBlock Text="启动器会尝试 UPnP 自动映射端口；路由器不支持 UPnP 或在 CGNAT 网络下，需要手动转发端口或使用其他内网穿透方式。"
                                   Style="{StaticResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="仅支持原版和 Fabric；Forge / NeoForge / Quilt 服务端请先使用对应安装器。"
                                   Style="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
