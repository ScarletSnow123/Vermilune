<UserControl x:Class="Vermilune.UI.Pages.MultiplayerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="24,0,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,12,0,0">
            <TextBlock Text="联机" Style="{StaticResource PageTitle}" />
            <TextBlock Text="在自己电脑上一键开个小服，朋友拿地址就能进。"
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <ScrollViewer x:Name="PageScroll" Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <StackPanel Margin="0,0,10,30">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="一键开服" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="服务端跑在你自己电脑上。原版和 Fabric 都能一键准备。"
                                   Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="实例" Style="{StaticResource FormLabel}" />
                                <ComboBox x:Name="ServerVersionCombo" Height="34" DisplayMemberPath="DisplayName" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="内存 MB" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="ServerMemoryBox" Style="{StaticResource InputBox}" Height="34" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="端口" Style="{StaticResource FormLabel}" />
                                <TextBox x:Name="ServerPortBox" Style="{StaticResource InputBox}" Height="34" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="现在只支持原版和 Fabric；Forge、NeoForge、Quilt 得先用对应安装器。"
                                   Style="{StaticResource MutedText}" Margin="0,9,0,0" TextWrapping="Wrap" />
                        <CheckBox x:Name="ServerEulaCheck" Content="我已阅读并同意 Minecraft 最终用户许可协议（EULA）"
                                  FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0" />
                        <CheckBox x:Name="ServerWhitelistCheck" Content="开白名单（要自己去 whitelist.json 加人）"
                                  FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />

                        <CheckBox x:Name="UseFrpCheck" Content="用 FRP 中继转发"
                                  FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0"
                                  Checked="UseFrp_Checked" Unchecked="UseFrp_Checked" />
                        <StackPanel x:Name="FrpPanel" Visibility="Collapsed" Margin="0,8,0,0">
                            <ComboBox x:Name="FrpProviderCombo" Height="32" Margin="0,0,0,8"
                                      SelectionChanged="FrpProvider_Changed">
                                <ComboBoxItem Content="OpenFrp（免费公共中继）" Tag="openfrp" />
                                <ComboBoxItem Content="自己的 frps" Tag="custom" />
                            </ComboBox>

                            <StackPanel x:Name="OpenFrpPanel">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="访问密钥" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="OpenFrpTokenBox" Style="{StaticResource InputBox}" Height="32" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="隧道 ID" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="OpenFrpTunnelBox" Style="{StaticResource InputBox}" Height="32" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="公网地址（面板里复制）" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="OpenFrpAddressBox" Style="{StaticResource InputBox}" Height="32" />
                                    </StackPanel>
                                </Grid>
                                <Button Style="{StaticResource PrimaryButton}" Height="34"
                                        Content="打开 OpenFrp 官网  →"
                                        HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenFrpSite_Click" />
                            </StackPanel>

                            <StackPanel x:Name="FrpCustomPanel" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="服务器 IP / 域名" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="FrpServerBox" Style="{StaticResource InputBox}" Height="32" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="frps 端口" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="FrpPortBox" Style="{StaticResource InputBox}" Height="32" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Token" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="FrpTokenBox" Style="{StaticResource InputBox}" Height="32" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="远程端口" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="FrpRemotePortBox" Style="{StaticResource InputBox}" Height="32" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="填自己的 frps 地址和 Token。"
                                           Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="ServerStartButton" Style="{StaticResource PrimaryButton}" Height="36"
                                    Padding="18,0" Content="一键开服" Click="StartServer_Click" />
                            <Button x:Name="ServerStopButton" Style="{StaticResource ButtonBase}" Height="36"
                                    Padding="16,0" Content="关闭服务器" Margin="8,0,0,0"
                                    IsEnabled="False" Click="StopServer_Click" />
                            <TextBlock x:Name="ServerStatusText" Text="没启动。" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>

                        <Border Background="{DynamicResource HomeLogInnerBrush}" CornerRadius="4"
                                Margin="0,10,0,0" Padding="7,5">
                            <ScrollViewer x:Name="ServerLogScroll" Height="96" VerticalScrollBarVisibility="Hidden"
                                          IsHitTestVisible="False">
                                <TextBlock x:Name="ServerLogText" Text="服务端日志会显示在这里…"
                                           FontFamily="{DynamicResource MonoFont}" FontSize="9"
                                           Foreground="{DynamicResource HomeLogTextBrush}"
                                           TextWrapping="NoWrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="地址" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="AddressText" Text="开服后这里显示地址。"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="16"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0" />
                        <TextBlock x:Name="Ipv6Text" Text="" FontFamily="{DynamicResource MonoFont}"
                                   FontSize="12" Foreground="{DynamicResource TextSubBrush}"
                                   TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed" />
                        <Border x:Name="MappingCallout" Visibility="Collapsed" CornerRadius="7"
                                Padding="11" Margin="0,10,0,0" BorderThickness="1"
                                Background="#22EB6B6B" BorderBrush="#55EB6B6B">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="8" Background="#33EB6B6B"
                                        VerticalAlignment="Top">
                                    <Path x:Name="MappingIcon" Data="{DynamicResource IconWarning}"
                                          Width="17" Height="17" Stretch="Uniform"
                                          Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.7"
                                          Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock x:Name="MappingTitle" Text="外网连不进来" FontSize="12"
                                               FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                                    <TextBlock x:Name="MappingText" Text="" FontSize="10.5"
                                               Foreground="{DynamicResource TextSubBrush}"
                                               Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource ButtonBase}" Height="32" Content="复制地址"
                                    Click="Copy_Click" />
                            <Button x:Name="CopyIpv6Button" Style="{StaticResource ButtonBase}" Height="32"
                                    Content="复制 IPv6" Margin="8,0,0,0" Visibility="Collapsed"
                                    Click="CopyIpv6_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="怎么用" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="1. 选个原版或 Fabric 实例，设好内存和端口。" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                        <TextBlock Text="2. 勾上 EULA，点「一键开服」。" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                        <TextBlock Text="3. 把地址发给朋友，多人游戏里直接连。" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                        <TextBlock Text="启动器会试着用 UPnP 开端口。路由器不支持，或者你是 CGNAT，就得手动转发或走中继。"
                                   Style="{StaticResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="目前只有原版和 Fabric 能一键开服。"
                                   Style="{StaticResource MutedText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
