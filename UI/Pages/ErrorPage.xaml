<UserControl x:Class="Vermilune.UI.Pages.ErrorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource UiFont}"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="SeverityPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,0,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="报错分析" Style="{StaticResource PageTitle}" />
                <TextBlock Text="解析 latest.log、crash-reports 与 mods 目录，定位缺失前置、冲突与 Java 问题。" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="VersionCombo" Width="250" Height="34" SelectionChanged="VersionCombo_SelectionChanged" />
                <Button Style="{StaticResource PrimaryButton}" Height="34" Padding="16,0" Content="重新分析" Margin="8,0,0,0"
                        Click="Analyze_Click" />
            </StackPanel>
        </Grid>

        <Border x:Name="SummaryCard" Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="SummaryIconBox" Width="42" Height="42" CornerRadius="12"
                        Background="{DynamicResource AccentSoftBrush}">
                    <Path x:Name="SummaryIcon" Data="{DynamicResource IconInfo}" Width="20" Height="20" Stretch="Uniform"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7" Fill="Transparent"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryTitle" Text="还没有分析记录" FontFamily="{DynamicResource DisplayFont}"
                               FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="SummarySub" Text="选择一个版本，然后点击「重新分析」。" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ButtonBase}" Height="32" Content="打开日志" Click="OpenLog_Click" Margin="0,0,7,0" />
                    <Button Style="{StaticResource ButtonBase}" Height="32" Content="打开崩溃报告" Click="OpenCrashFolder_Click" Margin="0,0,7,0" />
                    <Button Style="{StaticResource ButtonBase}" Height="32" Content="复制报告" Click="CopyReport_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="诊断结果" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="FindingCount" Text="" HorizontalAlignment="Right" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="1">
                    <ListBox x:Name="FindingList" Style="{StaticResource FlatListBox}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="3" CornerRadius="1.5" Background="{Binding SeverityBrush}"
                                                VerticalAlignment="Stretch" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <Grid>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <Border Style="{StaticResource SeverityPill}" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding SeverityText}" FontSize="9"
                                                               Foreground="{Binding SeverityBrush}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,7,0,0"
                                                       LineHeight="17" />
                                            <TextBlock Text="{Binding Suggestion}" FontSize="11.5" Foreground="{DynamicResource TextSubBrush}"
                                                       TextWrapping="Wrap" Margin="0,7,0,0" LineHeight="18" />
                                            <Border Background="#66000000" CornerRadius="6" Padding="8,6" Margin="0,8,0,0"
                                                    Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding Evidence}" FontFamily="{DynamicResource MonoFont}"
                                                           FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"
                                                           TextWrapping="Wrap" MaxHeight="58" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoFindings" Text="没有发现明确的错误。可以打开日志进一步检查。" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Grid>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Mods 概览" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="启用" Style="{StaticResource Label}" />
                                <TextBlock x:Name="ModEnabled" Text="—" FontFamily="{DynamicResource DisplayFont}"
                                           FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="问题" Style="{StaticResource Label}" />
                                <TextBlock x:Name="ModIssues" Text="—" FontFamily="{DynamicResource DisplayFont}"
                                           FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0"
                                           Foreground="{DynamicResource DangerBrush}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ModSummaryText" Text="分析后会在这里显示 Mod 统计。" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                        <Button Style="{StaticResource ButtonBase}" Height="32" Content="打开 Mods 文件夹"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenModsFolder_Click" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="日志文件" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="LogPathText" Text="—" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,9,0,0" />
                        <TextBlock x:Name="CrashPathText" Text="" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Button Style="{StaticResource ButtonBase}" Height="32" Content="打开启动器日志"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenLauncherLog_Click" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="快速修复建议" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="1. 先处理「严重」级别的问题，再启动游戏。" Style="{StaticResource MutedText}" Margin="0,9,0,0" />
                        <TextBlock Text="2. 缺前置时只安装对应版本，不要混用不同加载器的 Mod。" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                        <TextBlock Text="3. 报错页读取的是当前实例的 logs 与 crash-reports。" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border x:Name="LoadingOverlay" Grid.RowSpan="3" Background="#88000000" Visibility="Collapsed">
            <Border Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource StrokeStrongBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True" Width="48" Height="4" Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource TrackBrush}" BorderThickness="0" VerticalAlignment="Center" />
                    <TextBlock Text="正在分析日志…" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
