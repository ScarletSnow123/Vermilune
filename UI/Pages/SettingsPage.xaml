<UserControl x:Class="Vermilune.UI.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource UiFont}"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="Padding" Value="0,14" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,0,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
                <TextBlock Text="外观、启动、下载与数据目录。所有修改自动保存。" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource ButtonBase}" Height="34" Content="打开数据目录"
                    VerticalAlignment="Center" Click="OpenDataFolder_Click" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,30">

                <!-- 外观 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="外观" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="强调色、界面不透明度与背景图。" Style="{StaticResource Hint}" />
                        <Border Style="{StaticResource SettingRow}" Margin="0,12,0,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="强调色" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="用于按钮、选中状态与强调线。" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <WrapPanel x:Name="AccentPanel" HorizontalAlignment="Right" />
                                    <Grid Margin="0,8,0,0" HorizontalAlignment="Right">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="AccentHexBox" Style="{StaticResource InputBox}" Height="30" FontSize="11"
                                                 Tag="#E5B567" />
                                        <Button Grid.Column="1" Style="{StaticResource ButtonBase}" Height="30" Margin="6,0,0,0"
                                                Padding="10,0" Content="应用" Click="ApplyAccent_Click" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="RGB 调试" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="拖动 R / G / B 直接调整强调色，适合临时配色。" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="R" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <Slider x:Name="RgbRSlider" Width="62" Minimum="0" Maximum="255" Margin="5,0,0,0"
                                                ValueChanged="Rgb_ValueChanged" />
                                        <TextBlock Text="G" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="9,0,0,0" />
                                        <Slider x:Name="RgbGSlider" Width="62" Minimum="0" Maximum="255" Margin="5,0,0,0"
                                                ValueChanged="Rgb_ValueChanged" />
                                        <TextBlock Text="B" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="9,0,0,0" />
                                        <Slider x:Name="RgbBSlider" Width="62" Minimum="0" Maximum="255" Margin="5,0,0,0"
                                                ValueChanged="Rgb_ValueChanged" />
                                        <Border x:Name="RgbPreview" Width="28" Height="28" CornerRadius="7"
                                                Background="#E5B567" Margin="12,0,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="RgbHexText" Text="#E5B567" FontFamily="{DynamicResource MonoFont}"
                                               FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Right" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="界面不透明度" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock x:Name="OpacityValueText" Text="96%" FontSize="11" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="降低后可以透出桌面或背景图；文字始终保持清晰。" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Width="270">
                                    <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100"
                                            ValueChanged="OpacitySlider_ValueChanged" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="浅色模式" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="切换深色 / 浅色主题，配色和卡片会同步变化。" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="LightModeCheck" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Click="LightModeCheck_Click" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="背景图片" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="BgPathText" Text="把图片放进背景文件夹后点刷新" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                               HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource ButtonBase}" Height="30" Content="打开背景文件夹"
                                                Click="OpenBackgroundFolder_Click" />
                                        <Button Style="{StaticResource ButtonBase}" Height="30" Content="刷新"
                                                Margin="6,0,0,0" Click="RefreshBackground_Click" />
                                        <Button Style="{StaticResource GhostButton}" Height="30" Content="清除" Margin="6,0,0,0"
                                                Click="ClearBackground_Click" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0" HorizontalAlignment="Right">
                                        <TextBlock Text="图片不透明度" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Slider x:Name="BgOpacitySlider" Width="120" Minimum="0" Maximum="100"
                                                ValueChanged="BgOpacitySlider_ValueChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 启动 -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="启动" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="默认内存、Java 与实例隔离。单个版本的覆盖在「版本 → 修改」中设置。" Style="{StaticResource Hint}" />

                        <Border Style="{StaticResource SettingRow}" Margin="0,12,0,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="默认内存" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="MemHintText" Text="物理内存 32 GB · 推荐 8192 MB" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Width="300">
                                    <Grid>
                                        <Slider x:Name="MemorySlider" Minimum="512" Maximum="32768" TickFrequency="512"
                                                IsSnapToTickEnabled="True" ValueChanged="MemorySlider_ValueChanged" />
                                        <TextBlock x:Name="MemoryValueText" Text="4096 MB" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" FontSize="10.5"
                                                   Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                                   IsHitTestVisible="False" />
                                    </Grid>
                                    <Button Style="{StaticResource LinkButton}" Content="使用推荐值" HorizontalAlignment="Right"
                                            Margin="0,4,0,0" Click="UseRecommendedMemory_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="默认 Java" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="自动选择会优先匹配版本所需的大版本。" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                    <ComboBox x:Name="JavaCombo" Width="360" Height="34" SelectionChanged="JavaCombo_SelectionChanged" />
                                    <Button Style="{StaticResource ButtonBase}" Height="30" Content="扫描" Margin="6,0,0,0"
                                            Click="RescanJava_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="版本隔离" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="默认把每个版本放在自己的文件夹里，避免 Mods 与存档互相污染。" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="IsolationCheck" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Click="IsolationCheck_Click" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="启动后关关启动器" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="游戏启动后自动退出启动器，游戏进程会继续运行。" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="CloseAfterCheck" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Click="CloseAfterCheck_Click" />
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="JVM 优化参数" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="G1GC 与 Aikar 风格参数，适合大多数整合包；排查问题时可以关关。" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="OptimizeCheck" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Click="OptimizeCheck_Click" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 下载 -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="下载" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="下载源、CurseForge Key 与本地缓存。" Style="{StaticResource Hint}" />
                        <Border Style="{StaticResource SettingRow}" Margin="0,12,0,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="下载源" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="自动模式优先 Mojang 官方，失败后回退 BMCLAPI。" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                </StackPanel>
                                <ComboBox x:Name="SourceCombo" Width="230" Height="34" HorizontalAlignment="Right"
                                          SelectionChanged="SourceCombo_SelectionChanged" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="CurseForge API Key" FontSize="12.5" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                    <TextBox x:Name="CurseForgeKeyBox" Width="300" Height="32" Style="{StaticResource InputBox}"
                                             Tag="粘贴 CurseForge API Key" />
                                    <Button Style="{StaticResource ButtonBase}" Height="32" Content="保存" Margin="7,0,0,0"
                                            Click="SaveCurseForgeKey_Click" />
                                    <Button Style="{StaticResource LinkButton}" Content="获取" Margin="9,0,0,0"
                                            Click="OpenCurseForgeKey_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="缓存" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="CacheHint" Text="头像、接口缓存。" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ButtonBase}" Height="30" Content="打开缓存目录" Click="OpenCacheFolder_Click" />
                                    <Button Style="{StaticResource DangerButton}" Height="30" Content="清空缓存" Margin="7,0,0,0"
                                            Click="ClearCache_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 数据 -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="游戏目录" Style="{StaticResource SectionHeader}" />
                        <TextBlock x:Name="McPathText" Text="—" Style="{StaticResource Hint}" Margin="0,7,0,0"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                            <Button Style="{StaticResource ButtonBase}" Height="32" Content="更改目录" Click="ChangeMcDir_Click" />
                            <Button Style="{StaticResource ButtonBase}" Height="32" Content="打开目录" Margin="8,0,0,0"
                                    Click="OpenMcFolder_Click" />
                            <Button Style="{StaticResource ButtonBase}" Height="32" Content="重新扫描版本" Margin="8,0,0,0"
                                    Click="RescanVersions_Click" />
                        </StackPanel>
                        <TextBlock Text="启动器采用便携模式：配置、日志与实例设置保存在 exe 旁的 Vermilune 文件夹。"
                                   Style="{StaticResource Hint}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- 关于 -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="关于 Vermilune" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="版本 1.2.16-beta  ·  Minecraft 启动器  ·  .NET 10 / WPF"
                                   Style="{StaticResource Hint}" Margin="0,7,0,0" />
                        <TextBlock Text="启动、下载、Mod 管理与诊断功能都在本地完成。"
                                   Style="{StaticResource Hint}" Margin="0,7,0,0" />
                        <TextBlock Text="Minecraft 资源版权归 Mojang Studios 与各 Mod 作者所有。"
                                   Style="{StaticResource Hint}" Margin="0,7,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                            <Button Style="{StaticResource ButtonBase}" Height="30" Content="打开日志" Click="OpenLogs_Click" />
                            <Button Style="{StaticResource ButtonBase}" Height="30" Content="数据目录" Margin="8,0,0,0"
                                    Click="OpenDataFolder_Click" />
                            <Button Style="{StaticResource ButtonBase}" Height="30" Content="更多信息" Margin="8,0,0,0"
                                    Click="GoMore_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
