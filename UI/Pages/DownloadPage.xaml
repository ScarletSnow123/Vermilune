<UserControl x:Class="Vermilune.UI.Pages.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:Vermilune.UI.Pages"
             FontFamily="{DynamicResource UiFont}"
             Foreground="{DynamicResource TextBrush}">
    <Grid Margin="24,0,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="下载" Style="{StaticResource PageTitle}" />
                <TextBlock Text="安装原版、Fabric、Forge，或搜索整合包与资源；安装前请确认下载源可用。" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SourceText" Text="下载源：自动" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Style="{StaticResource ButtonBase}" Height="34" Content="刷新清单" Click="RefreshManifest_Click" Margin="0,0,8,0" />
                <Button Style="{StaticResource IconButton}" Width="34" Height="34" Click="OpenDownloadSettings_Click"
                        ToolTip="下载设置">
                    <Path Data="{DynamicResource IconTune}" Width="15" Height="15" Stretch="Uniform"
                          Stroke="{DynamicResource TextSubBrush}" StrokeThickness="1.6" Fill="Transparent" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 标签 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
            <RadioButton x:Name="TabGame" Style="{StaticResource TabItem}" GroupName="DownloadTabs" Content="游戏版本"
                         IsChecked="True" Checked="Tabs_Checked" Tag="game" />
            <RadioButton x:Name="TabFabric" Style="{StaticResource TabItem}" GroupName="DownloadTabs" Content="Fabric"
                         Checked="Tabs_Checked" Tag="fabric" />
            <RadioButton x:Name="TabForge" Style="{StaticResource TabItem}" GroupName="DownloadTabs" Content="Forge / NeoForge"
                         Checked="Tabs_Checked" Tag="forge" />
            <RadioButton x:Name="TabResource" Style="{StaticResource TabItem}" GroupName="DownloadTabs" Content="资源 / 整合包"
                         Checked="Tabs_Checked" Tag="resource" />
        </StackPanel>

        <!-- 游戏版本 -->
        <Grid x:Name="PanelGame" Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="VersionSearch" Style="{StaticResource InputBox}" Height="34"
                             Tag="搜索版本号…" TextChanged="VersionSearch_TextChanged" />
                    <ComboBox x:Name="TypeFilter" Grid.Column="2" Height="34" SelectionChanged="TypeFilter_SelectionChanged">
                        <ComboBoxItem Content="全部类型" IsSelected="True" />
                        <ComboBoxItem Content="正式版" />
                        <ComboBoxItem Content="快照" />
                        <ComboBoxItem Content="远古版本" />
                    </ComboBox>
                </Grid>
                <Grid Grid.Row="1">
                    <ListBox x:Name="VersionList" Style="{StaticResource FlatListBox}" SelectionChanged="VersionList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource FlatListItem}">
                                <Setter Property="Padding" Value="10,5" />
                                <Setter Property="Margin" Value="0,0,0,1" />
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="46">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Id}" FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ReleaseDateText}" FontSize="9.5"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" x:Name="InstalledPill" Style="{StaticResource Pill}" Margin="0,0,6,0"
                                            Visibility="{Binding Installed, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="已安装" FontSize="9" Foreground="{DynamicResource SuccessBrush}" />
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Pill}" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding DisplayType}" FontSize="9"
                                                   Foreground="{DynamicResource TextSubBrush}" />
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="→" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="4,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="VersionEmpty" Text="没有匹配的版本。" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    <ProgressBar x:Name="ManifestLoading" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource TrackBrush}" BorderThickness="0"
                                 Visibility="Collapsed" />
                </Grid>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                    <TextBlock Text="安装游戏版本" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="DetailTitle" Text="选择一个版本" FontFamily="{DynamicResource DisplayFont}"
                               FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailSub" Text="从左侧列表选择要安装的版本。" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    <Border Style="{StaticResource Divider}" />
                    <TextBlock x:Name="DetailNote" Text="安装会下载版本 JSON、客户端 jar、运行库与资源文件。已存在的文件会跳过。"
                               Style="{StaticResource MutedText}" LineHeight="18" />
                    <TextBlock Text="同时安装加载器（可选）" Style="{StaticResource FormLabel}" Margin="0,14,0,0" />
                    <ComboBox x:Name="VanillaLoaderCombo" Height="34" SelectionChanged="VanillaLoader_SelectionChanged">
                        <ComboBoxItem Content="原版（只装游戏本体）" IsSelected="True" Tag="" />
                        <ComboBoxItem Content="Fabric · 选择 Loader 版本" Tag="fabric" />
                        <ComboBoxItem Content="Forge · 自动选择推荐版" Tag="forge" />
                    </ComboBox>
                    <TextBlock Text="选择 Fabric / Forge 后，会先下载游戏本体，再自动继续安装加载器。" Style="{StaticResource MutedText}"
                               Margin="0,7,0,0" TextWrapping="Wrap" />
                    <StackPanel x:Name="FabricOptions" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="Fabric Loader 版本" Style="{StaticResource FormLabel}" />
                        <ComboBox x:Name="FabricDetailLoaderCombo" Height="34" DisplayMemberPath="Display" />
                        <Grid Margin="0,9,0,0">
                            <TextBlock Text="同时安装匹配的 Fabric API" FontSize="11.5" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <CheckBox x:Name="FabricDetailApiCheck" Style="{StaticResource Switch}" IsChecked="True"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="FabricDetailStatus" Text="" Style="{StaticResource MutedText}" Margin="0,5,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Height="40" Margin="0,16,0,0"
                            Content="安装此版本" IsEnabled="False" Click="InstallVanilla_Click" />
                    <TextBlock x:Name="InstallHint" Text="需要联网下载；可以在设置中切换镜像源。" Style="{StaticResource MutedText}"
                               Margin="0,9,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Fabric -->
        <Grid x:Name="PanelFabric" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="部署 Fabric" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Fabric 适合轻量整合包与大多数客户端 Mod。安装前会先确保对应原版版本存在。"
                               Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="游戏版本" Style="{StaticResource FormLabel}" />
                            <ComboBox x:Name="FabricMcCombo" Height="36" SelectionChanged="FabricMc_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Fabric Loader" Style="{StaticResource FormLabel}" />
                            <ComboBox x:Name="FabricLoaderCombo" Height="36" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="同时安装匹配的 Fabric API" FontSize="11.5" Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center" />
                        <CheckBox x:Name="FabricApiCheck" Style="{StaticResource Switch}" IsChecked="True"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="会按 游戏版本从 Modrinth 选择最新的兼容 Fabric API。" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                    <Button x:Name="InstallFabricButton" Style="{StaticResource PrimaryButton}" Height="40" Margin="0,14,0,0"
                            Content="部署 Fabric" IsEnabled="False" Click="InstallFabric_Click" />
                    <TextBlock x:Name="FabricStatus" Text="正在加载可用的 游戏版本…" Style="{StaticResource MutedText}" Margin="0,9,0,0" />
                    <Border Style="{StaticResource Divider}" />
                    <TextBlock Text="安装完成后会生成 fabric-loader-&lt;loader&gt;-&lt;mc&gt; 版本，并出现在「版本」列表中。"
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="版本要求" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Fabric 与原版版本一一对应；请先确认游戏版本已安装或允许自动安装。" Style="{StaticResource MutedText}" Margin="0,9,0,0" />
                    <Border Style="{StaticResource Divider}" />
                    <TextBlock Text="镜像" Style="{StaticResource Label}" />
                    <TextBlock Text="Fabric 元数据来自 meta.fabricmc.net；下载源设置只影响 Mojang 文件。" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    <Border Style="{StaticResource Divider}" />
                    <TextBlock Text="常见问题" Style="{StaticResource Label}" />
                    <TextBlock Text="如果 Loader 列表为空，检查网络或在设置中切换下载源后重试。" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Forge -->
        <Grid x:Name="PanelForge" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="部署 Forge" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="自动下载官方 installer，并以 --installClient 模式在后台完成 libraries、版本 JSON 与本体的安装。"
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,0" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="游戏版本" Style="{StaticResource FormLabel}" />
                            <ComboBox x:Name="ForgeMcCombo" Height="36" SelectionChanged="ForgeMc_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Forge 加载器版本" Style="{StaticResource FormLabel}" />
                            <ComboBox x:Name="ForgeVersionCombo" Height="36" />
                        </StackPanel>
                    </Grid>
                    <Button x:Name="InstallForgeButton" Style="{StaticResource PrimaryButton}" Height="40" Margin="0,18,0,0"
                            Content="一键部署 Forge" IsEnabled="False" Click="InstallForge_Click" />
                    <TextBlock x:Name="ForgeStatus" Text="选择 游戏版本后会加载可用的 Forge 加载器版本。" Style="{StaticResource MutedText}"
                               Margin="0,9,0,0" TextWrapping="Wrap" />
                    <Border Style="{StaticResource Divider}" />
                    <TextBlock Text="如果官方 installer 无法在后台运行，仍可使用本地安装器："
                               Style="{StaticResource MutedText}" Margin="0,0,0,7" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ButtonBase}" Height="32" Content="选择本地 installer" Click="RunForgeInstaller_Click" />
                        <Button Style="{StaticResource ButtonBase}" Height="32" Content="打开 Forge 下载页" Margin="8,0,0,0"
                                Click="OpenForgeSite_Click" />
                        <Button Style="{StaticResource ButtonBase}" Height="32" Content="刷新版本" Margin="8,0,0,0"
                                Click="RefreshVersions_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="安装说明" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Forge 会写入 .minecraft/libraries 并生成 versions 下的版本目录。"
                               Style="{StaticResource MutedText}" Margin="0,9,0,0" />
                    <TextBlock Text="1. 选择与整合包一致的 游戏版本。" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    <TextBlock Text="2. 优先使用推荐版 Forge；旧整合包请选对应版本。" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    <TextBlock Text="3. 安装完成后到「版本」页选择 Forge 实例，再把 Mod 放进 mods。" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    <Border Style="{StaticResource Divider}" />
                    <TextBlock Text="NeoForge" Style="{StaticResource Label}" />
                    <TextBlock Text="NeoForge 目前仍使用本地 installer；后续可加入官方 maven 直装。" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 资源 / 整合包 -->
        <Grid x:Name="PanelResource" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Padding="16">
                <pages:ResourceBrowser x:Name="ResourcePanel" />
            </Border>
        </Grid>

        <!-- 进度 -->
        <Border x:Name="ProgressCard" Grid.Row="3" Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="ProgressTitle" Text="正在安装…" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="ProgressPercent" Text="" HorizontalAlignment="Right" FontSize="10.5"
                                   Foreground="{DynamicResource TextSubBrush}" />
                    </Grid>
                    <ProgressBar x:Name="InstallProgress" Height="4" Minimum="0" Maximum="100" Margin="0,9,0,0"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource TrackBrush}" BorderThickness="0" />
                    <TextBlock x:Name="ProgressDetail" Text="" Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource DangerButton}" Height="32" Content="取消" Margin="16,0,0,0"
                        Click="CancelInstall_Click" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
