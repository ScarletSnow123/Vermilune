<UserControl x:Class="Vermilune.UI.Pages.ResourceBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Vermilune.UI.Controls"
             FontFamily="{DynamicResource UiFont}"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="ResourceProjectItem" TargetType="ListBoxItem" BasedOn="{StaticResource FlatListItem}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 搜索工具栏 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="TypeModpack" Style="{StaticResource TabItem}" GroupName="ResourceType"
                             Content="整合包" IsChecked="True" Checked="Type_Checked" Tag="modpack" />
                <RadioButton x:Name="TypeMod" Style="{StaticResource TabItem}" GroupName="ResourceType"
                             Content="Mod" Checked="Type_Checked" Tag="mod" />
                <RadioButton x:Name="TypeResourcePack" Style="{StaticResource TabItem}" GroupName="ResourceType"
                             Content="资源包" Checked="Type_Checked" Tag="resourcepack" />
                <RadioButton x:Name="TypeShader" Style="{StaticResource TabItem}" GroupName="ResourceType"
                             Content="光影" Checked="Type_Checked" Tag="shader" />
            </StackPanel>
            <ComboBox x:Name="SourceCombo" Grid.Column="1" Width="160" Height="34" Margin="12,0,0,0"
                      SelectionChanged="Source_SelectionChanged">
                <ComboBoxItem Content="Modrinth" IsSelected="True" />
                <ComboBoxItem Content="CurseForge" />
            </ComboBox>
            <Grid Grid.Column="2" Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="QueryBox" Style="{StaticResource InputBox}" Height="34" Tag="搜索整合包、Mod、资源包或光影…"
                         KeyDown="QueryBox_KeyDown" />
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="34" Padding="16,0" Content="搜索"
                        Margin="8,0,0,0" Click="Search_Click" />
            </Grid>
            <Button Grid.Column="3" Style="{StaticResource ButtonBase}" Height="34" Content="配置"
                    ToolTip="配置 CurseForge API Key"
                    x:Name="KeyButton" Visibility="Collapsed" Click="SetKey_Click" />
        </Grid>

        <!-- 筛选 -->
        <Grid Grid.Row="1" Margin="0,9,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="McCombo" Height="32" />
            <ComboBox x:Name="LoaderCombo" Grid.Column="2" Height="32">
                <ComboBoxItem Content="全部加载器" IsSelected="True" />
                <ComboBoxItem Content="Fabric" />
                <ComboBoxItem Content="Forge" />
                <ComboBoxItem Content="NeoForge" />
                <ComboBoxItem Content="Quilt" />
            </ComboBox>
            <TextBlock x:Name="SearchStatus" Grid.Column="3" Text="" Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <!-- 结果 + 详情 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox x:Name="ProjectList" Style="{StaticResource FlatListBox}"
                         ItemContainerStyle="{StaticResource ResourceProjectItem}" SelectionChanged="ProjectList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="58">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource Surface2Brush}"
                                        VerticalAlignment="Center" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <controls:AsyncImage Uri="{Binding IconUrl}" Stretch="UniformToFill"
                                                             RenderOptions.BitmapScalingMode="HighQuality">
                                            <controls:AsyncImage.Clip>
                                                <RectangleGeometry Rect="0,0,36,36" RadiusX="9" RadiusY="9" />
                                            </controls:AsyncImage.Clip>
                                        </controls:AsyncImage>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    <TextBlock FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0">
                                        <Run Text="{Binding Author, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding DownloadsText, Mode=OneWay}" /><Run Text=" 次下载" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="→" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="输入关键词开始搜索。" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <Button x:Name="LoadMoreButton" Grid.Row="1" Style="{StaticResource GhostButton}" Height="30"
                        HorizontalAlignment="Center" Content="加载更多" Visibility="Collapsed" Click="LoadMore_Click" />
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                <StackPanel>
                    <TextBlock Text="资源详情" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="DetailTitle" Text="选择一个项目" FontFamily="{DynamicResource DisplayFont}"
                               FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailSub" Text="" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                    <TextBlock x:Name="DetailSummary" Text="" Style="{StaticResource MutedText}" Margin="0,9,0,0"
                               TextWrapping="Wrap" MaxHeight="120" />
                    <Border Style="{StaticResource Divider}" />
                    <TextBlock Text="版本" Style="{StaticResource FormLabel}" />
                    <ComboBox x:Name="VersionCombo" Height="34" SelectionChanged="Version_SelectionChanged" />
                    <StackPanel x:Name="TargetPanel" Margin="0,9,0,0">
                        <TextBlock Text="安装到实例" Style="{StaticResource FormLabel}" />
                        <ComboBox x:Name="TargetCombo" Height="34" DisplayMemberPath="DisplayName" />
                    </StackPanel>
                    <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Height="38" Margin="0,14,0,0"
                            Content="安装" IsEnabled="False" Click="Install_Click" />
                    <ProgressBar x:Name="InstallProgress" Height="3" Margin="0,8,0,0" Visibility="Collapsed"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource TrackBrush}" BorderThickness="0" />
                    <TextBlock x:Name="InstallStatus" Text="" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                    <Button Style="{StaticResource LinkButton}" Content="打开项目主页" HorizontalAlignment="Left"
                            Margin="0,8,0,0" Click="OpenWebsite_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
