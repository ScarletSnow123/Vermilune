<UserControl x:Class="Vermilune.UI.Pages.LaunchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Vermilune.UI.Controls"
             xmlns:converters="clr-namespace:Vermilune.UI.Converters"
             FontFamily="{DynamicResource UiFont}"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <converters:PathImageConverter x:Key="PathImage" />

        <Style x:Key="HomeKicker" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style x:Key="HomeCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="#E61A1322" />
            <Setter Property="BorderBrush" Value="#2CFFFFFF" />
        </Style>

        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource HomeCard}">
            <Setter Property="Padding" Value="15,13" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <Style x:Key="CardAction" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="#36E8A2BE" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="RecentCard" TargetType="Button">
            <Setter Property="Width" Value="228" />
            <Setter Property="Height" Value="66" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Background" Value="#D91A1322" />
            <Setter Property="BorderBrush" Value="#2CFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18E8A2BE" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#55E8A2BE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,4,24,22" Background="#420D0912">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 主视觉：当前实例 -->
        <Border Grid.Row="0" Height="258" CornerRadius="22" BorderBrush="#30FFFFFF" BorderThickness="1" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#D92A1526" Offset="0" />
                    <GradientStop Color="#C71E1424" Offset="0.48" />
                    <GradientStop Color="#B417101D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Image Source="pack://application:,,,/Assets/VermiluneRing.png" Stretch="UniformToFill"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Width="360" Height="230" Opacity="0.11"
                       RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />
                <Border HorizontalAlignment="Right" Width="280" Margin="0,-40,-80,0" Height="280"
                        CornerRadius="140" Background="#16E8A2BE" IsHitTestVisible="False" />

                <Grid Margin="26,22,26,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="CURRENT INSTANCE  ·  当前实例" Style="{StaticResource HomeKicker}" />
                        <TextBlock Text="{Binding SelectedVersion.DisplayName}" FontFamily="{DynamicResource DisplayFont}"
                                   FontSize="37" FontWeight="SemiBold" Margin="0,7,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <ComboBox x:Name="VersionCombo" Height="42" Margin="0,12,0,0" MaxWidth="420"
                                  HorizontalAlignment="Left" MinWidth="300"
                                  ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                  SelectionChanged="VersionCombo_SelectionChanged" VerticalContentAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="30">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="25" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="23" Height="23" CornerRadius="7"
                                                Background="{DynamicResource Surface2Brush}" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Image Source="{Binding IconPath, Converter={StaticResource PathImage}}"
                                                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="9" Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="{Binding SubLine}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding LoaderBadge}" FontSize="9"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                                   Margin="10,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Border Style="{StaticResource Pill}" Background="#22E8A2BE" BorderBrush="#40E8A2BE"
                                    BorderThickness="1" Padding="8,3" Margin="0,0,7,0">
                                <TextBlock Text="{Binding SelectedVersion.MinecraftVersion}" FontSize="9.5"
                                           Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="#16FFFFFF" BorderBrush="#28FFFFFF"
                                    BorderThickness="1" Padding="8,3" Margin="0,0,7,0">
                                <TextBlock Text="{Binding SelectedVersion.LoaderBadge}" FontSize="9.5" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="#16FFFFFF" BorderBrush="#28FFFFFF"
                                    BorderThickness="1" Padding="8,3">
                                <TextBlock Text="Java" FontSize="9.5" Foreground="{DynamicResource TextSubBrush}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding VersionMeta}" FontSize="10.5" Margin="0,11,0,0"
                                   Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" MaxWidth="560" />

                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <Button Style="{StaticResource ButtonBase}" Height="32" Padding="14,0" Content="修改实例"
                                    Click="EditVersion_Click" Margin="0,0,7,0" />
                            <Button Style="{StaticResource ButtonBase}" Height="32" Padding="14,0" Content="打开目录"
                                    Click="OpenVersionFolder_Click" Margin="0,0,7,0" />
                            <Button Style="{StaticResource GhostButton}" Height="32" Padding="10,0" Content="版本管理 →"
                                    Click="ManageVersion_Click" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="26,0,0,0" Width="252">
                        <Button x:Name="LaunchButton" Height="64" Style="{StaticResource PrimaryButton}"
                                Click="Launch_Click" Padding="18,0" HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="LaunchIcon" Width="18" Height="20" Stretch="Uniform"
                                      Data="{DynamicResource IconPlay}" Fill="#FF2A101B" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LaunchTitleText" Text="{Binding LaunchTitle}" FontSize="16"
                                               FontWeight="Bold" FontFamily="{DynamicResource DisplayFont}"
                                               Foreground="#FF2A101B" />
                                    <TextBlock x:Name="LaunchSubText" Text="{Binding LaunchSub}" FontSize="9.5"
                                               Foreground="#B02A101B" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" x:Name="LaunchHint" Text="ENTER" FontSize="8.5"
                                           Foreground="#802A101B" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Border x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,8,0,0"
                                Background="#AA0F0A14" BorderBrush="#33FFFFFF"
                                BorderThickness="1" CornerRadius="11" Padding="11,8">
                            <StackPanel>
                                <Grid>
                                    <TextBlock x:Name="ProgressText" Text="准备启动…" FontSize="9.5"
                                               Foreground="{DynamicResource TextSubBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button HorizontalAlignment="Right" Style="{StaticResource LinkButton}" Content="取消"
                                            FontSize="9" Click="CancelLaunch_Click" />
                                </Grid>
                                <ProgressBar x:Name="LaunchProgress" Height="3" Margin="0,6,0,0" Minimum="0" Maximum="100"
                                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource TrackBrush}"
                                             BorderThickness="0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding DateText}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Right" Margin="0,10,0,0" />
                        <TextBlock Text="MINECRAFT · VERMILUNE" FontSize="8.5"
                                   Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 状态条 -->
        <Grid Grid.Row="1" Margin="0,13,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1.05*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="#38E8A2BE" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="AvatarInitialText" Text="{Binding AvatarInitial}" FontSize="15"
                                       FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="AvatarImage" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AccountName}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding AccountSub}" FontSize="9"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="25" Padding="8,0"
                            FontSize="9.5" Content="切换" Click="Account_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}">
                        <Path Data="{DynamicResource IconBox}" Width="15" Height="15" Stretch="Uniform"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModCount}" FontFamily="{DynamicResource DisplayFont}" FontSize="19"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="已安装 Mod" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource StatCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}">
                        <Path Data="{DynamicResource IconSpark}" Width="15" Height="15" Stretch="Uniform"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ResourcePackCount}" FontFamily="{DynamicResource DisplayFont}"
                                   FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="资源包" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource StatCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource SuccessBrush}"
                             VerticalAlignment="Center" Margin="4,0,0,0" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="启动状态" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding Text, ElementName=StatusLabel}" FontSize="9.5"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 主内容 -->
        <Grid Grid.Row="2" Margin="0,13,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="HomeContentScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,16">
                    <Grid Margin="2,0,0,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="实例资源" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="INSTANCE CONTENT" Style="{StaticResource HomeKicker}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Height="25"
                                Padding="8,0" FontSize="9.5" Content="刷新" Click="RefreshHome_Click" />
                    </Grid>

                    <UniformGrid Columns="4">
                        <Border Style="{StaticResource HomeCard}" Margin="0,0,10,0">
                            <StackPanel>
                                <Grid>
                                    <Border Style="{StaticResource IconTile}" Width="32" Height="32" HorizontalAlignment="Left">
                                        <Path Data="{DynamicResource IconBox}" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="MODS" FontSize="8" Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top" />
                                </Grid>
                                <TextBlock Text="Mods" FontSize="12.5" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding ModCount, StringFormat={}{0} 个}" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                <Button Style="{StaticResource CardAction}" Content="管理 →" Click="ManageVersion_Click" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HomeCard}" Margin="0,0,10,0">
                            <StackPanel>
                                <Grid>
                                    <Border Style="{StaticResource IconTile}" Width="32" Height="32" HorizontalAlignment="Left">
                                        <Path Data="{DynamicResource IconSpark}" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="PACKS" FontSize="8" Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top" />
                                </Grid>
                                <TextBlock Text="资源包" FontSize="12.5" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding ResourcePackCount, StringFormat={}{0} 个}" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                <Button Style="{StaticResource CardAction}" Content="打开 →" Click="OpenVersionFolder_Click" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HomeCard}" Margin="0,0,10,0">
                            <StackPanel>
                                <Grid>
                                    <Border Style="{StaticResource IconTile}" Width="32" Height="32" HorizontalAlignment="Left">
                                        <Path Data="{DynamicResource IconFolder}" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="SAVES" FontSize="8" Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top" />
                                </Grid>
                                <TextBlock Text="存档" FontSize="12.5" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding SaveCount, StringFormat={}{0} 个}" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                <Button Style="{StaticResource CardAction}" Content="打开 →" Click="OpenVersionFolder_Click" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HomeCard}">
                            <StackPanel>
                                <Grid>
                                    <Border Style="{StaticResource IconTile}" Width="32" Height="32" HorizontalAlignment="Left">
                                        <Path Data="{DynamicResource IconSpark}" Width="15" Height="15" Stretch="Uniform"
                                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Fill="Transparent"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="SHADERS" FontSize="8" Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top" />
                                </Grid>
                                <TextBlock Text="光影" FontSize="12.5" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding ShaderCount, StringFormat={}{0} 个}" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                <Button Style="{StaticResource CardAction}" Content="打开 →" Click="OpenVersionFolder_Click" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Margin="2,18,0,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="最近游玩" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="RECENT" Style="{StaticResource HomeKicker}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding RecentItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RecentCard}" Tag="{Binding VersionId}" Click="Recent_Click">
                                    <Grid Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="10"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                BorderBrush="#38E8A2BE" BorderThickness="1">
                                            <Path Data="{DynamicResource IconPlay}" Fill="{DynamicResource AccentBrush}"
                                                  Width="9" Height="9" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SubLine}" FontSize="9"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="8.5"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="RecentEmpty" Text="还没有游玩记录。启动一次游戏后，这里会出现快捷入口。"
                               FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="2,2,0,4"
                               Visibility="Collapsed" />

                    <Border Style="{StaticResource HomeCard}" Margin="0,16,0,0" Padding="16">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="启动日志" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Height="24"
                                        Padding="8,0" FontSize="9.5" Content="完整日志" Click="OpenLog_Click" />
                            </Grid>
                            <TextBlock x:Name="StatusLabel" Text="就绪。" FontSize="10.5"
                                       Foreground="{DynamicResource TextSubBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
                            <Border Background="{DynamicResource OverlayBrush}" CornerRadius="9" Padding="9,7" Margin="0,8,0,0"
                                    Visibility="{Binding HasLog, Converter={StaticResource BoolToVisibility}}">
                                <ScrollViewer MaxHeight="92" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                                    <TextBlock Text="{Binding LogText}" FontFamily="{DynamicResource MonoFont}"
                                               FontSize="9" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="HomeSideScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,18">
                    <Border Style="{StaticResource HomeCard}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="角色外观" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="APPEARANCE" Style="{StaticResource HomeKicker}" Margin="9,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button x:Name="SkinModelLabel" Style="{StaticResource GhostButton}" Content="Steve"
                                        Height="23" Padding="7,0" FontSize="9" HorizontalAlignment="Right"
                                        Click="ToggleSkinModel_Click" />
                            </Grid>
                            <Grid Margin="0,11,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="128" Height="166" CornerRadius="13" Background="#8A0F0A14"
                                        BorderBrush="#2CFFFFFF" BorderThickness="1" ClipToBounds="True">
                                    <controls:SkinPreview3D x:Name="SkinPreview" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SkinNameLabel" Text="皮肤：默认" FontSize="9.5"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="CapeNameLabel" Text="披风：无" FontSize="9"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="拖动预览旋转" FontSize="8.5"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                                    <Button Style="{StaticResource ButtonBase}" Height="27" Content="切换皮肤"
                                            Margin="0,8,0,0" FontSize="9.5" Click="SwitchSkin_Click" />
                                    <Button Style="{StaticResource ButtonBase}" Height="27" Content="切换披风"
                                            Margin="0,5,0,0" FontSize="9.5" Click="SwitchCape_Click" />
                                    <Button Style="{StaticResource LinkButton}" Content="使用账号皮肤" FontSize="8.5"
                                            HorizontalAlignment="Left" Margin="0,5,0,0" Click="UseAccountSkin_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource HomeCard}" Margin="0,12,0,0" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="72" Height="72" CornerRadius="14" ClipToBounds="True"
                                    Background="{DynamicResource Surface2Brush}">
                                <Image x:Name="FeaturedImage" Source="pack://application:,,,/Assets/VermiluneRing.png"
                                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="FeaturedTitleText" Text="Vermilune 1.2" FontSize="15"
                                           FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="FeaturedSubtitleText" Text="这张卡片可以自定义。"
                                           FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                <Button Style="{StaticResource CardAction}" Content="自定义 →"
                                        Click="CustomizeFeatured_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource HomeCard}" Margin="0,12,0,0" Padding="14">
                        <StackPanel>
                            <TextBlock Text="快捷工具" FontSize="11.5" FontWeight="SemiBold" />
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="7" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource ButtonBase}" Height="28"
                                        FontSize="9.5" Content="游戏目录" Click="OpenMcFolder_Click" />
                                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource ButtonBase}" Height="28"
                                        FontSize="9.5" Content="启动器数据" Click="OpenDataFolder_Click" />
                                <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource ButtonBase}" Height="28"
                                        FontSize="9.5" Content="任务管理器" Click="ToolTaskmgr_Click" />
                                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource ButtonBase}" Height="28"
                                        FontSize="9.5" Content="CMD" Click="ToolCmd_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
