<UserControl x:Class="Vermilune.UI.Pages.VersionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vermilune.UI.Pages"
             xmlns:converters="clr-namespace:Vermilune.UI.Converters"
             FontFamily="{DynamicResource UiFont}"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <converters:PathImageConverter x:Key="PathImage" />
        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}" />
            <Setter Property="Padding" Value="0,13" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,0,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧列表 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="版本管理" Style="{StaticResource PageTitle}" />
                <TextBlock Text="选择实例，修改启动参数，管理 Mods。" Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,16,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="VersionSearch" Style="{StaticResource InputBox}" Height="34" Tag="搜索版本…"
                         TextChanged="VersionSearch_TextChanged" />
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="34" Height="34"
                        Click="RefreshVersions_Click" ToolTip="重新扫描">
                    <Path Data="{DynamicResource IconRefresh}" Width="15" Height="15" Stretch="Uniform"
                          Stroke="{DynamicResource TextSubBrush}" StrokeThickness="1.6" Fill="Transparent" />
                </Button>
            </Grid>

            <ListBox x:Name="VersionList" Grid.Row="2" Style="{StaticResource FlatListBox}"
                     SelectionChanged="VersionList_SelectionChanged" Margin="0,0,0,8">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource FlatListItem}">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="IsEnabled" Value="True" />
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="46">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Surface2Brush}"
                                    ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="{Binding Initial}" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image Source="{Binding IconPath, Converter={StaticResource PathImage}}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}" Opacity="1" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SubLine}" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource Pill}">
                                <TextBlock Text="{Binding LoaderBadge}" FontSize="9"
                                           Foreground="{DynamicResource TextSubBrush}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="NoVersionsText" Grid.Row="3" Text="没有查测到版本。可以先到「下载」安装。"
                       Style="{StaticResource MutedText}" Margin="2,8,0,0" Visibility="Collapsed" />
        </Grid>

        <!-- 右侧详情 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 头部 -->
            <Border Style="{StaticResource Card}" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="HeaderIcon" Width="48" Height="48" CornerRadius="13"
                            Background="{DynamicResource Surface2Brush}" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="HeaderInitial" Text="V" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Image x:Name="HeaderIconImage" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderName" Text="选择一个版本" FontFamily="{DynamicResource DisplayFont}"
                                   FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,0">
                                <TextBlock x:Name="HeaderLoader" Text="Vanilla" FontSize="9.5"
                                           Foreground="{DynamicResource TextSubBrush}" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,0">
                                <TextBlock x:Name="HeaderMc" Text="1.21.8" FontSize="9.5"
                                           Foreground="{DynamicResource TextSubBrush}" />
                            </Border>
                            <Border Style="{StaticResource Pill}">
                                <TextBlock x:Name="HeaderMods" Text="0 Mods" FontSize="9.5"
                                           Foreground="{DynamicResource TextSubBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Height="34" Padding="15,0" Content="启动"
                                Click="Launch_Click" Margin="0,0,7,0" />
                        <Button Style="{StaticResource ButtonBase}" Height="34" Padding="12,0" Content="打开目录"
                                Click="OpenFolder_Click" Margin="0,0,7,0" />
                        <Button Style="{StaticResource IconButton}" Width="34" Height="34" Margin="0,0,7,0"
                                Click="Rename_Click" ToolTip="重命名">
                            <Path Data="{DynamicResource IconEdit}" Width="15" Height="15" Stretch="Uniform"
                                  Fill="Transparent" Stroke="{DynamicResource TextSubBrush}" StrokeThickness="1.6" />
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Height="34" Padding="12,0" Content="删除"
                                Click="Delete_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 标签 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,9,0,0">
                <RadioButton x:Name="TabOverview" Style="{StaticResource TabItem}" GroupName="VersionTabs"
                             Content="概览" IsChecked="True" Checked="Tab_Checked" Tag="overview" />
                <RadioButton x:Name="TabModify" Style="{StaticResource TabItem}" GroupName="VersionTabs"
                             Content="修改" Checked="Tab_Checked" Tag="modify" />
                <RadioButton x:Name="TabMods" Style="{StaticResource TabItem}" GroupName="VersionTabs"
                             Content="Mods" Checked="Tab_Checked" Tag="mods" />
                <RadioButton x:Name="TabLog" Style="{StaticResource TabItem}" GroupName="VersionTabs"
                             Content="日志" Checked="Tab_Checked" Tag="log" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <!-- 概览 -->
                <ScrollViewer x:Name="PanelOverview" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="实例信息" Style="{StaticResource SectionTitle}" />
                                    <Border Style="{StaticResource SettingRow}" Margin="0,10,0,0">
                                        <Grid>
                                            <TextBlock Text="Minecraft" Style="{StaticResource Label}" />
                                            <TextBlock x:Name="OvMc" Text="—" HorizontalAlignment="Right" FontSize="12" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <TextBlock Text="加载器" Style="{StaticResource Label}" />
                                            <TextBlock x:Name="OvLoader" Text="—" HorizontalAlignment="Right" FontSize="12" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <TextBlock Text="建议 Java" Style="{StaticResource Label}" />
                                            <TextBlock x:Name="OvJava" Text="—" HorizontalAlignment="Right" FontSize="12" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                        <Grid>
                                            <TextBlock Text="游戏目录" Style="{StaticResource Label}" />
                                            <TextBlock x:Name="OvGameDir" Text="—" HorizontalAlignment="Right" FontSize="10.5"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="300"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        </Grid>
                                    </Border>
                                    <Button Style="{StaticResource ButtonBase}" Height="32" Content="打开版本目录"
                                            HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenFolder_Click" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="运行状态" Style="{StaticResource SectionTitle}" />
                                    <Border Style="{StaticResource SettingRow}" Margin="0,10,0,0">
                                        <Grid>
                                            <TextBlock Text="Mod 数量" Style="{StaticResource Label}" />
                                            <TextBlock x:Name="OvMods" Text="0" HorizontalAlignment="Right" FontSize="12" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <TextBlock Text="内存分配" Style="{StaticResource Label}" />
                                            <TextBlock x:Name="OvMemory" Text="4096 MB" HorizontalAlignment="Right" FontSize="12" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <TextBlock Text="上次启动" Style="{StaticResource Label}" />
                                            <TextBlock x:Name="OvLast" Text="从未" HorizontalAlignment="Right" FontSize="12" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                        <Grid>
                                            <TextBlock Text="全局隔离" Style="{StaticResource Label}" />
                                            <TextBlock x:Name="OvIsolate" Text="开启" HorizontalAlignment="Right" FontSize="12" />
                                        </Grid>
                                    </Border>
                                    <Button Style="{StaticResource SoftButton}" Height="32" Content="转到修改"
                                            HorizontalAlignment="Left" Margin="0,12,0,0" Click="GoModify_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="路径" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="OvJsonPath" Text="—" Style="{StaticResource MonoText}"
                                           TextWrapping="Wrap" Margin="0,9,0,0" />
                                <TextBlock Text="实例设置保存在启动器数据目录，不会改写版本 JSON。"
                                           Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 修改（重做的核心页面） -->
                <ScrollViewer x:Name="PanelModify" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="启动参数" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="修改会立即保存到当前实例，不影响其他版本。" Style="{StaticResource RowSub}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="SaveStatus" Text="" FontSize="10.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SuccessBrush}" Margin="0,0,12,0" />
                                <Button Style="{StaticResource GhostButton}" Height="32" Content="恢复默认"
                                        Click="ResetModify_Click" Margin="0,0,7,0" />
                                <Button Style="{StaticResource PrimaryButton}" Height="32" Padding="18,0"
                                        Content="保存修改" Click="SaveModify_Click" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="内存" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="MemValue" Grid.Column="1" Text="4096 MB"
                                               Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Slider x:Name="MemSlider" Minimum="512" Maximum="32768" TickFrequency="512"
                                        IsSnapToTickEnabled="True" Margin="0,10,0,0"
                                        ValueChanged="MemSlider_ValueChanged" />
                                <Grid Margin="0,8,0,0">
                                    <TextBlock x:Name="MemHint" Text="物理内存 32 GB · 推荐 8192 MB" Style="{StaticResource MutedText}" />
                                    <Button Style="{StaticResource LinkButton}" Content="使用推荐值" HorizontalAlignment="Right"
                                            Click="UseRecommendedMemory_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Java" Style="{StaticResource SectionTitle}" />
                                    <CheckBox x:Name="JavaAutoCheck" Style="{StaticResource Switch}" Content="自动选择匹配版本"
                                              Margin="0,10,0,0" Checked="JavaAuto_Changed" Unchecked="JavaAuto_Changed" />
                                    <ComboBox x:Name="JavaCombo" Height="34" Margin="0,10,0,0" />
                                    <Grid Margin="0,7,0,0">
                                        <TextBlock x:Name="JavaHint" Text="该版本建议 Java 17" Style="{StaticResource MutedText}" />
                                        <Button Style="{StaticResource LinkButton}" Content="重新扫描" HorizontalAlignment="Right"
                                                Click="RescanJava_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="窗口" Style="{StaticResource SectionTitle}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="宽度" Style="{StaticResource FormLabel}" />
                                            <TextBox x:Name="WidthBox" Style="{StaticResource InputBox}" Height="34" Tag="默认" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="高度" Style="{StaticResource FormLabel}" />
                                            <TextBox x:Name="HeightBox" Style="{StaticResource InputBox}" Height="34" Tag="默认" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="FullscreenCheck" Style="{StaticResource Switch}" Content="全屏启动"
                                              Margin="0,11,0,0" />
                                    <TextBlock Text="留空则使用游戏内设置。" Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="隔离与优化" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="版本隔离" Style="{StaticResource FormLabel}" />
                                        <ComboBox x:Name="IsolateCombo" Height="34">
                                            <ComboBoxItem Content="跟随全局设置" />
                                            <ComboBoxItem Content="总是隔离（推荐整合包）" />
                                            <ComboBoxItem Content="不隔离（使用 .minecraft）" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="JVM 优化" Style="{StaticResource FormLabel}" />
                                        <CheckBox x:Name="OptimizeCheck" Style="{StaticResource Switch}" Content="使用 G1GC 优化参数"
                                                  VerticalAlignment="Center" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="高级参数" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="JVM 参数（每行或空格分隔）" Style="{StaticResource FormLabel}" Margin="0,12,0,6" />
                                <TextBox x:Name="JvmArgsBox" Style="{StaticResource MultilineInput}" MinHeight="58" Height="58" Tag="-XX:+UseG1GC …" />
                                <TextBlock Text="游戏参数（会追加到主类之后）" Style="{StaticResource FormLabel}" Margin="0,10,0,6" />
                                <TextBox x:Name="GameArgsBox" Style="{StaticResource MultilineInput}" MinHeight="58" Height="58" Tag="--width 1280 …" />
                                <TextBlock Text="不要在这里填写账号令牌；启动器会自动注入认证参数。" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="维护" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="重命名会同步修改版本 JSON 与 inheritsFrom；删除会移到回收站。"
                                           Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                    <Button Style="{StaticResource ButtonBase}" Height="32" Content="重命名" Click="Rename_Click" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource DangerButton}" Height="32" Content="删除此版本" Click="Delete_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Mods -->
                <Grid x:Name="PanelMods" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="ModSummary" Text="0 个 Mod" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="ModHint" Text="开启/关闭会重命名 .jar 文件；不会删除内容。" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource ButtonBase}" Height="32" Content="打开 Mods 文件夹"
                                        Click="OpenModsFolder_Click" Margin="0,0,8,0" />
                                <Button Style="{StaticResource ButtonBase}" Height="32" Content="分析冲突"
                                        Click="AnalyzeMods_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,10,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ModSearch" Style="{StaticResource InputBox}" Height="34" Tag="搜索 Mod 名称、ID 或文件名…"
                                 TextChanged="ModSearch_TextChanged" />
                        <TextBlock Grid.Column="1" x:Name="ModFilterInfo" Text="" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="ModList" Style="{StaticResource FlatListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}"
                                                  VerticalAlignment="Center" Click="ModToggle_Click" Tag="{Binding FilePath}" />
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SubTitle}" FontSize="9.5"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="9.5"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                                   Margin="8,0" />
                                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="28" Height="28"
                                                Click="DeleteMod_Click" Tag="{Binding FilePath}" ToolTip="删除到回收站">
                                            <Path Data="{DynamicResource IconTrash}" Width="13" Height="13" Stretch="Uniform"
                                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5" Fill="Transparent" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="ModEmpty" Text="mods 文件夹为空，或没有匹配的 Mod。" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </Grid>

                <!-- 日志 -->
                <Grid x:Name="PanelLog" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="14">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="运行日志" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="LogPathText" Text="latest.log" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource ButtonBase}" Height="32" Content="打开日志文件夹" Click="OpenLogFolder_Click" Margin="0,0,8,0" />
                                <Button Style="{StaticResource ButtonBase}" Height="32" Content="分析报错" Click="AnalyzeCrash_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBox x:Name="LogBox" Grid.Row="1" Style="{StaticResource MultilineInput}" Margin="0,10,0,0"
                             IsReadOnly="True" FontFamily="{DynamicResource MonoFont}" FontSize="10.5"
                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
