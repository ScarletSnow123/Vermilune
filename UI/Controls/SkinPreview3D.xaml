<UserControl x:Class="Vermilune.UI.Controls.SkinPreview3D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" ClipToBounds="True">
    <Grid x:Name="Host" Background="Transparent" ClipToBounds="True">
        <Image x:Name="PreviewImage" Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />
        <TextBlock x:Name="Hint" Text="皮肤预览" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" IsHitTestVisible="False" />
    </Grid>
</UserControl>
