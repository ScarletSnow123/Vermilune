<Window x:Class="Vermilune.UI.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="470" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource UiFont}">
    <Border Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource StrokeStrongBrush}"
            BorderThickness="1" CornerRadius="10" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBox" Width="38" Height="38" CornerRadius="11"
                        Background="{DynamicResource AccentSoftBrush}">
                    <Path x:Name="IconPath" Data="{DynamicResource IconInfo}" Width="18" Height="18"
                          Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7"
                          Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" Text="提示" FontFamily="{DynamicResource DisplayFont}"
                           FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="13,0,0,0" />
            </Grid>
            <TextBlock x:Name="MessageText" Text="消息" FontSize="12.5" Foreground="{DynamicResource TextSubBrush}"
                       TextWrapping="Wrap" Margin="0,18,0,0" LineHeight="20" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="SecondaryButton" Content="取消" Style="{StaticResource ButtonBase}"
                        Margin="0,0,8,0" Visibility="Collapsed" IsCancel="True" Click="Secondary_Click" />
                <Button x:Name="PrimaryButton" Content="好的" Style="{StaticResource PrimaryButton}"
                        MinWidth="86" IsDefault="True" Click="Primary_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
