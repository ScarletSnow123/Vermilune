<Window x:Class="Vermilune.UI.Dialogs.CapePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Vermilune.UI.Controls"
        Width="520" Height="450" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource UiFont}">
    <Window.Resources>
        <Style x:Key="CapeItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="2,0,0,0" CornerRadius="6" Padding="8,4" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource StrokeStrongBrush}"
            BorderThickness="1" CornerRadius="10" Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="选择披风" FontFamily="{DynamicResource DisplayFont}" FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="AccountText" Text="" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Grid.Row="1" Text="选择账号拥有的披风。" Style="{StaticResource MutedText}" Margin="0,7,0,12" />
            <Border Grid.Row="2" Background="{DynamicResource Surface2Brush}" CornerRadius="9" Padding="4">
                <Grid>
                    <ListBox x:Name="CapeList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource CapeItem}" SelectionChanged="CapeList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <controls:AsyncImage Uri="{Binding ImageUrl}" Crop="0,0,10,16"
                                                        Width="22" Height="36" Stretch="Uniform"
                                                        VerticalAlignment="Center"
                                                        RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12"
                                               VerticalAlignment="Center" Margin="7,0,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="9.5"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="LoadingText" Text="正在读取披风…" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <TextBlock x:Name="StatusText" Text="" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource ButtonBase}" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button x:Name="ApplyButton" Content="应用" Style="{StaticResource PrimaryButton}"
                            MinWidth="86" IsEnabled="False" Click="Apply_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
