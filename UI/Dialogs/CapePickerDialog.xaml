<Window x:Class="Vermilune.UI.Dialogs.CapePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Vermilune.UI.Controls"
        Width="800" Height="560" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource UiFont}">
    <Window.Resources>
        <Style x:Key="CapeItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="2,0,0,0" CornerRadius="6" Padding="8,4" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource StrokeStrongBrush}"
            BorderThickness="1" CornerRadius="10" Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="选择披风" FontFamily="{DynamicResource DisplayFont}" FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="AccountText" Text="" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Grid.Row="1" Text="从账号现有的披风中选择，右侧预览会直接穿在角色身上。" Style="{StaticResource MutedText}"
                       Margin="0,7,0,12" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="9" Padding="4">
                    <Grid>
                        <ListBox x:Name="CapeList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource CapeItem}"
                                 SelectionChanged="CapeList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="42" CornerRadius="5" Background="{DynamicResource Surface3Brush}"
                                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                                VerticalAlignment="Center" ClipToBounds="True">
                                            <controls:AsyncImage Uri="{Binding ImageUrl}" Crop="12,1,10,16"
                                                                 Width="24" Height="36" Stretch="Uniform"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="7,0,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="9.5"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="LoadingText" Text="正在读取披风…" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource Surface2Brush}" CornerRadius="9" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="预览" Style="{StaticResource SectionTitle}" />
                        <Border Grid.Row="1" Width="190" Height="250" CornerRadius="8" Background="{DynamicResource Surface3Brush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" ClipToBounds="True"
                                HorizontalAlignment="Center" Margin="0,10,0,0">
                            <controls:SkinPreview3D x:Name="Preview" />
                        </Border>
                        <StackPanel Grid.Row="2" Margin="0,9,0,0">
                            <TextBlock x:Name="SelectedName" Text="未选择" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="拖动预览可以旋转" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <TextBlock x:Name="StatusText" Text="" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource ButtonBase}" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button x:Name="ApplyButton" Content="应用" Style="{StaticResource PrimaryButton}"
                            MinWidth="86" IsEnabled="False" Click="Apply_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
