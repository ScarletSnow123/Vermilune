<Window x:Class="Vermilune.UI.Dialogs.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="470" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource UiFont}">
    <Border Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource StrokeStrongBrush}"
            BorderThickness="1" CornerRadius="10" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="输入" FontFamily="{DynamicResource DisplayFont}"
                       FontSize="17" FontWeight="SemiBold" />
            <TextBlock x:Name="MessageText" Text="请输入内容" FontSize="12" Foreground="{DynamicResource TextSubBrush}"
                       TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBox x:Name="Input" Style="{StaticResource InputBox}" Margin="0,14,0,0" Height="38" />
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="10.5"
                       Margin="0,7,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" Style="{StaticResource ButtonBase}" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
                <Button Content="确定" Style="{StaticResource PrimaryButton}" MinWidth="86" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
