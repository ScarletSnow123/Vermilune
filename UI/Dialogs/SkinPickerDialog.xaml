<Window x:Class="Vermilune.UI.Dialogs.SkinPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Vermilune.UI.Controls"
        Width="800" Height="560" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource UiFont}">
    <Border Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource StrokeStrongBrush}"
            BorderThickness="1" CornerRadius="0" Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="选择皮肤" FontFamily="{DynamicResource DisplayFont}" FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Text="皮肤库" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="0" Padding="10" ClipToBounds="True">
                    <ListBox x:Name="SkinList" Style="{StaticResource FlatListBox}"
                             ItemContainerStyle="{StaticResource FlatListItem}" SelectionChanged="SkinList_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="92" Margin="4">
                                    <Border Width="76" Height="76" CornerRadius="0" Background="{DynamicResource Surface3Brush}"
                                            ClipToBounds="True" HorizontalAlignment="Center">
                                        <Image Source="{Binding Path}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="9.5" Foreground="{DynamicResource TextSubBrush}"
                                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <TextBlock x:Name="EmptyText" Text="皮肤库还是空的，点右下角「导入」添加。" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

                <Border Grid.Column="2" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="0" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="预览" Style="{StaticResource SectionTitle}" />
                        <Border Grid.Row="1" Width="190" Height="222" CornerRadius="0" Background="{DynamicResource Surface3Brush}"
                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" ClipToBounds="True"
                                HorizontalAlignment="Center" Margin="0,10,0,0">
                            <controls:SkinPreview3D x:Name="Preview" />
                        </Border>
                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <TextBlock x:Name="NameText" Text="未选择" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ModelText" Text="" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            <ComboBox x:Name="ModelCombo" Height="30" Margin="0,8,0,0"
                                      SelectionChanged="ModelCombo_SelectionChanged">
                                <ComboBoxItem Content="Steve / 粗手臂" />
                                <ComboBoxItem Content="Alex / 细手臂" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <TextBlock x:Name="StatusText" Text="" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource ButtonBase}" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button x:Name="ApplyButton" Content="使用此皮肤" Style="{StaticResource PrimaryButton}"
                            MinWidth="108" IsEnabled="False" Click="Apply_Click" />
                    <Button x:Name="ImportButton" Content="导入" Style="{StaticResource ButtonBase}"
                            Height="34" Padding="14,0" Margin="8,0,0,0" Click="ImportButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="导入单个图片…" Click="ImportImage_Click" />
                                <MenuItem Header="导入整个文件夹…" Click="ImportFolder_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
