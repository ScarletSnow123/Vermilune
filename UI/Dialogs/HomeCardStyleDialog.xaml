<Window x:Class="Vermilune.UI.Dialogs.HomeCardStyleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="卡片样式" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextBrush}">
    <Border Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource StrokeStrongBrush}"
            BorderThickness="1" CornerRadius="10" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="7" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <TextBlock Text="卡片样式" FontFamily="{DynamicResource DisplayFont}" FontSize="18" FontWeight="SemiBold" />
                <Button HorizontalAlignment="Right" Style="{StaticResource LinkButton}" Content="×" FontSize="15" Click="Cancel_Click" />
            </Grid>
            <TextBlock Text="调整旋转、大小、字号与透明度。" Style="{StaticResource MutedText}" Margin="0,4,0,0" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                <TextBlock Text="旋转" FontSize="11" VerticalAlignment="Center" />
                <Slider x:Name="RotationSlider" Grid.Column="1" Minimum="-180" Maximum="180" TickFrequency="15"
                        IsSnapToTickEnabled="True" ValueChanged="ValueChanged" />
                <TextBlock x:Name="RotationValue" Grid.Column="2" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                <TextBlock Text="大小" FontSize="11" VerticalAlignment="Center" />
                <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="50" Maximum="200" TickFrequency="5"
                        IsSnapToTickEnabled="True" ValueChanged="ValueChanged" />
                <TextBlock x:Name="ScaleValue" Grid.Column="2" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                <TextBlock Text="字号" FontSize="11" VerticalAlignment="Center" />
                <Slider x:Name="FontSlider" Grid.Column="1" Minimum="50" Maximum="200" TickFrequency="5"
                        IsSnapToTickEnabled="True" ValueChanged="ValueChanged" />
                <TextBlock x:Name="FontValue" Grid.Column="2" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                <TextBlock Text="透明度" FontSize="11" VerticalAlignment="Center" />
                <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="20" Maximum="100" TickFrequency="5"
                        IsSnapToTickEnabled="True" ValueChanged="ValueChanged" />
                <TextBlock x:Name="OpacityValue" Grid.Column="2" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Grid Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource LinkButton}" Content="恢复默认" FontSize="10" Click="Reset_Click" />
                    <Button x:Name="DeleteButton" Style="{StaticResource LinkButton}" Content="删除卡片" FontSize="10"
                            Foreground="{DynamicResource DangerBrush}" Margin="14,0,0,0" Visibility="Collapsed"
                            Click="Delete_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ButtonBase}" Height="32" Padding="14,0" Content="取消" Click="Cancel_Click" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" Content="保存" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
