<Window x:Class="Vermilune.UI.Dialogs.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource UiFont}">
    <Border Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource StrokeStrongBrush}"
            BorderThickness="1" CornerRadius="10" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="账号" FontFamily="{DynamicResource DisplayFont}" FontSize="19" FontWeight="SemiBold" />
            <TextBlock x:Name="CurrentText" Text="当前：Player（离线）" FontSize="11.5"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,7,0,0" />

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="已保存账号" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="切换不需要重新登录" FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="登录过 Microsoft / 外置账号后会保留在这里，点账号即可切换。"
                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SavedList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="36" Background="Transparent" Cursor="Hand"
                                      Tag="{Binding Id}" MouseLeftButtonUp="SavedAccount_Click"
                                      ToolTip="点击切换到这个账号">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding TypeText}" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="8,0,10,0" />
                                    <Button Grid.Column="2" Content="{Binding ActionText}" Tag="{Binding Id}"
                                            Style="{StaticResource ButtonBase}" Height="28" Padding="10,0"
                                            IsEnabled="{Binding CanSwitch}" Click="SwitchAccount_Click" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="11" Background="#222F81F7">
                        <TextBlock Text="MS" FontSize="12" FontWeight="Bold" Foreground="#FF7FB5F0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Microsoft 正版账号" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="设备代码登录 · 支持皮肤与正版服务器" FontSize="10.5"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="登录" Style="{StaticResource PrimaryButton}" Height="32"
                            Padding="14,0" Click="Microsoft_Click" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,10,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="离线" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="离线账号" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="仅用于离线游戏与离线服务器" FontSize="10.5"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OfflineName" Style="{StaticResource InputBox}" Height="34"
                                 Tag="输入游戏内昵称（1-16 个字符）" MaxLength="16" />
                        <Button Grid.Column="2" Content="使用离线账号" Style="{StaticResource ButtonBase}" Height="34"
                                Click="Offline_Click" />
                    </Grid>
                    <TextBlock x:Name="OfflineError" FontSize="10.5" Foreground="{DynamicResource DangerBrush}"
                               Margin="0,7,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,10,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="11" Background="#2234D399">
                            <TextBlock Text="外置" FontSize="10" FontWeight="Bold" Foreground="#FF62D9A7"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Yggdrasil 外置登录" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="LittleSkin 等皮肤站 · 通过 authlib-injector 登录" FontSize="10.5"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="YggServer" Style="{StaticResource InputBox}" Height="34" Margin="0,12,0,0"
                             Text="https://littleskin.cn/api/yggdrasil" Tag="外置登录服务器地址" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="YggUser" Style="{StaticResource InputBox}" Height="34"
                                 Tag="邮箱或用户名" />
                        <PasswordBox x:Name="YggPassword" Grid.Column="2" Height="34" Padding="10,0"
                                     FontFamily="{DynamicResource UiFont}" FontSize="12.5"
                                     Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="YggError" FontSize="10.5" Foreground="{DynamicResource DangerBrush}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
                        <Button x:Name="YggButton" Grid.Column="1" Content="登录外置账号"
                                Style="{StaticResource ButtonBase}" Height="34" Click="Yggdrasil_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="关闭" Style="{StaticResource ButtonBase}" Click="Close_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
