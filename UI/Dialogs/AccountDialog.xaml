<Window x:Class="Vermilune.UI.Dialogs.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource TextBrush}">
    <Border Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource StrokeStrongBrush}"
            BorderThickness="1" CornerRadius="10" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="账号" FontFamily="{DynamicResource DisplayFont}" FontSize="19" FontWeight="SemiBold" />
            <TextBlock x:Name="CurrentText" Text="当前：Player（离线）" FontSize="11.5"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <RadioButton x:Name="TabSaved" Style="{StaticResource TabItem}" GroupName="AccountTab"
                             Content="已保存" Tag="saved" IsChecked="True" Checked="AccountTab_Checked" />
                <RadioButton x:Name="TabMicrosoft" Style="{StaticResource TabItem}" GroupName="AccountTab"
                             Content="微软" Tag="microsoft" Checked="AccountTab_Checked" />
                <RadioButton x:Name="TabOffline" Style="{StaticResource TabItem}" GroupName="AccountTab"
                             Content="离线" Tag="offline" Checked="AccountTab_Checked" />
                <RadioButton x:Name="TabYgg" Style="{StaticResource TabItem}" GroupName="AccountTab"
                             Content="外置" Tag="ygg" Checked="AccountTab_Checked" />
                <RadioButton x:Name="TabNide" Style="{StaticResource TabItem}" GroupName="AccountTab"
                             Content="通行证" Tag="nide" Checked="AccountTab_Checked" />
            </StackPanel>

            <Grid Margin="0,10,0,0">
                <!-- 已保存 -->
                <StackPanel x:Name="PanelSaved">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="已保存账号" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="点击即切换" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="SavedList" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="38" Background="Transparent" Cursor="Hand"
                                                  Tag="{Binding Id}" MouseLeftButtonUp="SavedAccount_Click"
                                                  ToolTip="点击切换到这个账号">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding TypeText}" FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center" Margin="8,0,10,0" />
                                                <Button Grid.Column="2" Content="{Binding ActionText}" Tag="{Binding Id}"
                                                        Style="{StaticResource ButtonBase}" Height="28" Padding="10,0"
                                                        IsEnabled="{Binding CanSwitch}" Click="SwitchAccount_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 微软 -->
                <StackPanel x:Name="PanelMicrosoft" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="10" Background="#222F81F7">
                                    <TextBlock Text="MS" FontSize="12" FontWeight="Bold" Foreground="#FF7FB5F0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Microsoft 正版账号" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="登录" Style="{StaticResource PrimaryButton}" Height="32"
                                        Padding="14,0" Click="Microsoft_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 离线 -->
                <StackPanel x:Name="PanelOffline" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="离线" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="离线账号" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OfflineName" Style="{StaticResource InputBox}" Height="34"
                                         Tag="输入游戏内昵称（1-64 个字符；1.20.3+ 最多 16）" MaxLength="64" />
                                <Button Grid.Column="2" Content="使用离线账号" Style="{StaticResource PrimaryButton}" Height="34"
                                        Click="Offline_Click" />
                            </Grid>
                            <TextBlock x:Name="OfflineError" FontSize="10.5" Foreground="{DynamicResource DangerBrush}"
                                       Margin="0,7,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 外置 -->
                <StackPanel x:Name="PanelYgg" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="10" Background="#2234D399">
                                    <TextBlock Text="外置" FontSize="10" FontWeight="Bold" Foreground="#FF62D9A7"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Yggdrasil 外置登录" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock x:Name="YggRoleHint" Text="" FontSize="10" Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,3,0,0" Visibility="Collapsed" />
                                </StackPanel>
                                <Button x:Name="YggRoleButton" Grid.Column="2" Content="切换角色" Style="{StaticResource ButtonBase}"
                                        Height="28" Padding="10,0" Visibility="Collapsed" Click="ThirdPartyRole_Click" />
                            </Grid>
                            <TextBox x:Name="YggServer" Style="{StaticResource InputBox}" Height="34" Margin="0,14,0,0"
                                     Text="https://littleskin.cn/api/yggdrasil" Tag="外置登录服务器地址" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="YggUser" Style="{StaticResource InputBox}" Height="34"
                                         Tag="登录邮箱（推荐）或角色名" />
                                <PasswordBox x:Name="YggPassword" Grid.Column="2" Height="34" Padding="10,0"
                                             FontFamily="{DynamicResource UiFont}" FontSize="12.5"
                                             Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="YggError" FontSize="10.5" Foreground="{DynamicResource DangerBrush}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
                                <Button x:Name="YggButton" Grid.Column="1" Content="登录外置账号"
                                        Style="{StaticResource PrimaryButton}" Height="34" Click="Yggdrasil_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 通行证 -->
                <StackPanel x:Name="PanelNide" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="10" Background="#223B82F6">
                                    <TextBlock Text="通行证" FontSize="9" FontWeight="Bold" Foreground="#FF7FB5F0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="统一通行证" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock x:Name="NideRoleHint" Text="" FontSize="10" Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,3,0,0" Visibility="Collapsed" />
                                </StackPanel>
                                <Button x:Name="NideRoleButton" Grid.Column="2" Content="切换角色" Style="{StaticResource ButtonBase}"
                                        Height="28" Padding="10,0" Visibility="Collapsed" Click="ThirdPartyRole_Click" />
                            </Grid>
                            <TextBox x:Name="NideServer" Style="{StaticResource InputBox}" Height="34" Margin="0,14,0,0"
                                     Tag="服务器 ID" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NideUser" Style="{StaticResource InputBox}" Height="34"
                                         Tag="邮箱或统一通行证账号" />
                                <PasswordBox x:Name="NidePassword" Grid.Column="2" Height="34" Padding="10,0"
                                             FontFamily="{DynamicResource UiFont}" FontSize="12.5"
                                             Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextBrush}"
                                             BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NideError" FontSize="10.5" Foreground="{DynamicResource DangerBrush}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
                                <Button x:Name="NideButton" Grid.Column="1" Content="登录统一通行证"
                                        Style="{StaticResource PrimaryButton}" Height="34" Click="Nide_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Margin="0,18,0,0">
                <Button x:Name="LogoutButton" Content="退出当前账号" Style="{StaticResource ButtonBase}"
                        Height="32" HorizontalAlignment="Left" Visibility="Collapsed" Click="Logout_Click" />
                <Button Content="关闭" Style="{StaticResource ButtonBase}" HorizontalAlignment="Right" Click="Close_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
