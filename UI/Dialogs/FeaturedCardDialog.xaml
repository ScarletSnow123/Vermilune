<Window x:Class="Vermilune.UI.Dialogs.FeaturedCardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource UiFont}">
    <Border Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource StrokeStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="自定义首页卡片" FontFamily="{DynamicResource DisplayFont}"
                       FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="图片、标题、描述和文字颜色都可以改成自己的，默认样式会保留。"
                       FontSize="11" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="112" Height="112" CornerRadius="12" ClipToBounds="True"
                        Background="{DynamicResource OverlayBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1">
                    <Image x:Name="PreviewImage" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="卡片图片" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock x:Name="ImagePathText" Text="未选择，使用默认图片" FontSize="10.5"
                               Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ButtonBase}" Height="30" Content="选择图片"
                                Padding="12,0" Click="ChooseImage_Click" />
                        <Button Style="{StaticResource ButtonBase}" Height="30" Content="恢复默认"
                                Padding="12,0" Margin="8,0,0,0" Click="Reset_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <TextBlock Text="标题" FontSize="11" Foreground="{DynamicResource TextSubBrush}" Margin="0,16,0,6" />
            <TextBox x:Name="TitleBox" Style="{StaticResource InputBox}" Height="36" Tag="例如：←----觉真可爱" />
            <TextBlock Text="描述" FontSize="11" Foreground="{DynamicResource TextSubBrush}" Margin="0,12,0,6" />
            <TextBox x:Name="SubtitleBox" Style="{StaticResource InputBox}" Height="36" Tag="例如：古明地觉 · 地灵殿的主人" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="大字颜色" FontSize="11" Foreground="{DynamicResource TextSubBrush}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="38" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TitleColorBox" Style="{StaticResource InputBox}" Height="36"
                                 Tag="#FFF4A6C0" TextChanged="TitleColorBox_TextChanged" />
                        <Border x:Name="TitleColorPreview" Grid.Column="1" Width="34" Height="34"
                                CornerRadius="7" Margin="4,1,0,0" BorderBrush="{DynamicResource StrokeBrush}"
                                BorderThickness="1" Background="#FFF4A6C0" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="小字颜色" FontSize="11" Foreground="{DynamicResource TextSubBrush}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="38" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SubtitleColorBox" Style="{StaticResource InputBox}" Height="36"
                                 Tag="留空使用主题次要文字色" TextChanged="SubtitleColorBox_TextChanged" />
                        <Border x:Name="SubtitleColorPreview" Grid.Column="1" Width="34" Height="34"
                                CornerRadius="7" Margin="4,1,0,0" BorderBrush="{DynamicResource StrokeBrush}"
                                BorderThickness="1" Background="{DynamicResource TextMutedBrush}" />
                    </Grid>
                </StackPanel>
            </Grid>
            <TextBlock Text="颜色支持 #RRGGBB 或 #AARRGGBB；留空的小字颜色跟随主题。"
                       FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="10.5"
                       Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" Style="{StaticResource ButtonBase}" Margin="0,0,8,0"
                        IsCancel="True" Click="Cancel_Click" />
                <Button Content="保存" Style="{StaticResource PrimaryButton}" MinWidth="86"
                        IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
