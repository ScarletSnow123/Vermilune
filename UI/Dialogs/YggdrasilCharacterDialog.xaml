<Window x:Class="Vermilune.UI.Dialogs.YggdrasilCharacterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource UiFont}">
    <Border Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource StrokeStrongBrush}"
            BorderThickness="1" CornerRadius="10" Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="选择角色" FontFamily="{DynamicResource DisplayFont}" FontSize="19"
                       FontWeight="SemiBold" MouseLeftButtonDown="Header_MouseLeftButtonDown" />
            <TextBlock Text="该外置账号下有多个角色，选择要登录的那一个。"
                       Style="{StaticResource MutedText}" Margin="0,7,0,12" />
            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="4">
                <ListBox x:Name="CharacterList" Background="Transparent" BorderThickness="0"
                         MouseDoubleClick="CharacterList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="38">
                                <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Style="{StaticResource ButtonBase}" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="使用此角色" Style="{StaticResource PrimaryButton}" MinWidth="100"
                        Click="Apply_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
