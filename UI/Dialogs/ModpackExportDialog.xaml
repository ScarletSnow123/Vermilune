<Window x:Class="Vermilune.UI.Dialogs.ModpackExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource TextBrush}">
    <Border Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource StrokeStrongBrush}"
            BorderThickness="1" CornerRadius="10" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="导出整合包" FontFamily="{DynamicResource DisplayFont}" FontSize="18" FontWeight="SemiBold" />
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="整合包名称" Style="{StaticResource Label}" />
                    <TextBox x:Name="NameBox" Style="{StaticResource InputBox}" Height="34" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="版本" Style="{StaticResource Label}" />
                    <TextBox x:Name="VersionBox" Style="{StaticResource InputBox}" Height="34" Margin="0,5,0,0" Text="1.0.0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="打包内容" Style="{StaticResource FormLabel}" Margin="0,16,0,0" />
            <WrapPanel Margin="0,7,0,0">
                <CheckBox x:Name="ModsCheck" Content="Mods" IsChecked="True" Margin="0,0,18,8" />
                <CheckBox x:Name="ConfigCheck" Content="config" IsChecked="True" Margin="0,0,18,8" />
                <CheckBox x:Name="PacksCheck" Content="资源包" IsChecked="True" Margin="0,0,18,8" />
                <CheckBox x:Name="ShadersCheck" Content="光影" IsChecked="True" Margin="0,0,18,8" />
                <CheckBox x:Name="SavesCheck" Content="存档" Margin="0,0,18,8" />
                <CheckBox x:Name="OptionsCheck" Content="options.txt" IsChecked="True" Margin="0,0,18,8" />
            </WrapPanel>

            <TextBlock x:Name="StatusText" Text="" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                       TextWrapping="Wrap" />
            <Grid Margin="0,18,0,0">
                <Button x:Name="ExportButton" Content="开始导出" Style="{StaticResource PrimaryButton}" Height="36"
                        Width="120" HorizontalAlignment="Right" Click="Export_Click" />
                <Button Content="取消" Style="{StaticResource ButtonBase}" Height="36" Width="80"
                        HorizontalAlignment="Right" Margin="0,0,128,0" Click="Close_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
