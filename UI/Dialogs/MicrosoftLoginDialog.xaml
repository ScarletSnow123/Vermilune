<Window x:Class="Vermilune.UI.Dialogs.MicrosoftLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource UiFont}">
    <Border Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource StrokeStrongBrush}"
            BorderThickness="1" CornerRadius="10" Padding="26">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Microsoft 账户登录" FontFamily="{DynamicResource DisplayFont}" FontSize="19"
                       FontWeight="SemiBold" />
            <TextBlock Text="通过 Microsoft 设备代码授权。浏览器只用于登录账号。"
                       FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                       Margin="0,7,0,0" />

            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="在浏览器中输入以下代码" FontSize="10.5"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock x:Name="CodeText" Text="······" FontFamily="{DynamicResource MonoFont}"
                               FontSize="27" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                               Margin="0,8,0,0" />
                    <TextBlock x:Name="UrlText" Text="https://www.microsoft.com/link" FontSize="11"
                               Foreground="{DynamicResource TextSubBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="OpenButton" Content="打开登录页" Style="{StaticResource PrimaryButton}"
                        Height="32" Padding="13,0" Click="Open_Click" IsEnabled="False" />
                <Button x:Name="CopyButton" Content="复制代码" Style="{StaticResource ButtonBase}"
                        Height="32" Padding="13,0" Margin="8,0,0,0" Click="Copy_Click" IsEnabled="False" />
            </StackPanel>

            <ProgressBar x:Name="Spinner" IsIndeterminate="True" Height="3" Margin="0,18,0,0"
                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource TrackBrush}" BorderThickness="0" />
            <TextBlock x:Name="StatusText" Text="正在获取登录代码…" FontSize="11.5"
                       Foreground="{DynamicResource TextSubBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorText" FontSize="11" Foreground="{DynamicResource DangerBrush}"
                       Margin="0,9,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="RetryButton" Content="重试" Style="{StaticResource ButtonBase}" Margin="0,0,8,0"
                        Visibility="Collapsed" Click="Retry_Click" />
                <Button Content="取消" Style="{StaticResource ButtonBase}" Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
