<Window x:Class="Vermilune.UI.Dialogs.HomeCustomizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义主页" Width="420" SizeToContent="Height" MaxHeight="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextBrush}">
    <Border Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource StrokeStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="主页卡片" Style="{StaticResource PageTitle}" FontSize="21" />
            <TextBlock Text="列出当前主页上的全部卡片；隐藏后仍可在这里恢复。" Style="{StaticResource MutedText}" Margin="0,5,0,0" />

            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0">
                <StackPanel x:Name="CardsPanel" />
            </ScrollViewer>

            <Grid Margin="0,18,0,0">
                <Button Style="{StaticResource LinkButton}" Content="恢复默认" HorizontalAlignment="Left"
                        FontSize="10.5" Click="Reset_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ButtonBase}" Height="32" Padding="14,0" Content="取消"
                            Click="Cancel_Click" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}" Height="32" Padding="16,0" Content="保存"
                            Click="Save_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
