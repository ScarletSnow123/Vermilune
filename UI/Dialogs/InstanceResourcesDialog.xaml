<Window x:Class="Vermilune.UI.Dialogs.InstanceResourcesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource UiFont}">
    <Border Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource StrokeStrongBrush}"
            BorderThickness="1" CornerRadius="14" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <StackPanel>
                    <TextBlock Text="实例资源" FontFamily="{DynamicResource DisplayFont}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="InstanceText" Text="" FontSize="11"
                               Foreground="{DynamicResource TextSubBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource LinkButton}"
                        Content="关闭" Click="Close_Click" />
            </Grid>

            <UniformGrid Columns="4" Margin="0,18,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="MODS" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="ModCount" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="已安装 Mod" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                        <Button Style="{StaticResource ButtonBase}" Height="28" Content="打开 Mods"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenMods_Click" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="PACKS" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="PackCount" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="资源包" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                        <Button Style="{StaticResource ButtonBase}" Height="28" Content="打开资源包"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenPacks_Click" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="SAVES" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="SaveCount" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="存档" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                        <Button Style="{StaticResource ButtonBase}" Height="28" Content="打开存档"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenSaves_Click" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="SHADERS" Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="ShaderCount" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="光影" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                        <Button Style="{StaticResource ButtonBase}" Height="28" Content="打开光影"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenShaders_Click" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,18,0,0">
                <TextBlock Text="资源路径按当前实例隔离设置计算" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Style="{StaticResource ButtonBase}" Height="30" Padding="14,0"
                        Content="打开实例目录" Click="OpenInstance_Click" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
