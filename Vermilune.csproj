<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Vermilune</AssemblyName>
    <RootNamespace>Vermilune</RootNamespace>
    <ApplicationIcon>Assets\Vermilune.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.3.0</Version>
    <FileVersion>1.3.0.0</FileVersion>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <InformationalVersion>1.3.0</InformationalVersion>
    <Product>Vermilune</Product>
    <Company>Vermilune Project</Company>
    <Description>Vermilune Minecraft 启动器</Description>
    <Copyright>© 2026 Vermilune Project</Copyright>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);CA1416;WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Vermilune.ico" />
    <Resource Include="Assets\Satori.jpg" />
    <Resource Include="Assets\SatoriCard.png" />
    <Resource Include="Assets\VermiluneRing.png" />
    <Resource Include="Assets\VermiluneIcon.png" />
  </ItemGroup>

  <ItemGroup Condition="'$(VERMILUNE_CURSEFORGE_API_KEY)' != ''">
    <EmbeddedResource Include="$(IntermediateOutputPath)curseforge.key"
                      LogicalName="Vermilune.Secrets.CurseForgeKey" />
  </ItemGroup>

  <!-- 私有 CurseForge Key：从环境变量注入到 exe 资源，不写进源码。 -->
  <Target Name="EmbedPrivateSecrets" BeforeTargets="PrepareResources"
          Condition="'$(VERMILUNE_CURSEFORGE_API_KEY)' != ''">
    <PropertyGroup>
      <_CurseForgeSecretFile>$(IntermediateOutputPath)curseforge.key</_CurseForgeSecretFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(_CurseForgeSecretFile)"
                      Lines="$(VERMILUNE_CURSEFORGE_API_KEY)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
